{% comment %}
  =============================================================================
  SECTION: bed-comparison-wizard.liquid
  PURPOSE: Two-step continental bed comparison widget
    Step 1 — Card-based model selector (up to 3 picks)
    Step 2 — Full comparison table (reuses old widget block logic)
  =============================================================================
{% endcomment %}

{% assign checkbox_icon = '<svg class="icon-check" viewBox="0 0 16 16" fill="currentColor"><path d="M6.0 11.0l-3.5-3.5 1.5-1.5L6.0 8.0l6.0-6.0 1.5 1.5z"/></svg>' %}

<section id="section-{{ section.id }}" class="bcw">

  {%- comment -%}────────────────────────────────────────
    STEP 0 — Bed Type Selection
  ────────────────────────────────────────{%- endcomment -%}
  <div class="bcw__step bcw__step--0" data-step="0" {% if section.settings.skip_step0 %}hidden{% endif %}>

    <div class="bcw__orb bcw__orb--tl"></div>
    <div class="bcw__orb bcw__orb--br"></div>

    <div class="bcw__step1-inner">

      <h2 class="bcw__heading">
        {{ section.settings.step0_heading | default: 'Vælg hvilken type seng ønsker I jer?' }}
      </h2>

      <div class="bcw__divider-wrap">
        <div class="bcw__divider-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 249.4 80.35" aria-hidden="true">
            <path fill="currentColor" d="M215.82,59.52V7.43c0-4.79-3.89-7.43-8.68-7.43H42.78c-4.79,0-8.68,2.64-8.68,7.43l-.06,36.98c5.83-.47,12.33-.75,19.57-.71v-13.33c0-5.99,4.86-10.84,10.84-10.84l44.72-.04c5.99,0,10.84,4.85,10.84,10.84v21.79c1.45.34,9.79,2.24,9.79,2.24v-23.99c0-5.99,4.85-10.84,10.84-10.84h44.75c5.99,0,10.84,4.86,10.84,10.84v30.88c7.27-.27,13.72-.91,19.57-1.74"/>
            <path fill="currentColor" d="M0,57.3v3.8s45.34-7.03,124.93,12.84c79.59,19.88,124.47-12.84,124.47-12.84v-3.8s-44.88,22.33-124.47,2.49C45.34,39.94,0,57.3,0,57.3"/>
          </svg>
        </div>
      </div>

      <div class="bcw__cards bcw__cards--type" role="group" aria-label="Vælg sengtype">

        {%- comment -%} Kontinentalseng {%- endcomment -%}
        <div class="bcw__card bcw__type-card" data-type="kontinental" role="button" tabindex="0">
          <div class="bcw__card-img-wrap">
            {% if section.settings.type_img_kontinental != blank %}
              <img src="{{ section.settings.type_img_kontinental | image_url: width: 480, height: 360, crop: 'center' }}"
                   alt="Kontinentalseng" width="480" height="360" loading="lazy" draggable="false">
            {% else %}
              <div class="bcw__card-img-placeholder"></div>
            {% endif %}
            <div class="bcw__card-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
          </div>
          <span class="bcw__card-label">{{ section.settings.type_label_kontinental | default: 'Kontinentalseng' }}</span>
        </div>

        {%- comment -%} Elevationsseng {%- endcomment -%}
        <div class="bcw__card bcw__type-card" data-type="elevation"
             data-url="{{ section.settings.type_url_elevation }}"
             role="button" tabindex="0">
          <div class="bcw__card-img-wrap">
            {% if section.settings.type_img_elevation != blank %}
              <img src="{{ section.settings.type_img_elevation | image_url: width: 480, height: 360, crop: 'center' }}"
                   alt="Elevationsseng" width="480" height="360" loading="lazy" draggable="false">
            {% else %}
              <div class="bcw__card-img-placeholder"></div>
            {% endif %}
            <div class="bcw__card-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
          </div>
          <span class="bcw__card-label">{{ section.settings.type_label_elevation | default: 'Elevationsseng' }}</span>
        </div>

        {%- comment -%} Boxmadras {%- endcomment -%}
        <div class="bcw__card bcw__type-card" data-type="boxmadras"
             data-url="{{ section.settings.type_url_boxmadras }}"
             role="button" tabindex="0">
          <div class="bcw__card-img-wrap">
            {% if section.settings.type_img_boxmadras != blank %}
              <img src="{{ section.settings.type_img_boxmadras | image_url: width: 480, height: 360, crop: 'center' }}"
                   alt="Boxmadras" width="480" height="360" loading="lazy" draggable="false">
            {% else %}
              <div class="bcw__card-img-placeholder"></div>
            {% endif %}
            <div class="bcw__card-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
          </div>
          <span class="bcw__card-label">{{ section.settings.type_label_boxmadras | default: 'Boxmadras' }}</span>
        </div>

      </div>
    </div>

    <div class="bcw__nav-bar">
      <div class="bcw__nav-bar-left">
        <button class="bcw__nav-arrow" aria-label="Tilbage" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
      </div>
      <div class="bcw__nav-bar-center">
        <span class="bcw__nav-title">{{ section.settings.nav_title_0 | default: 'Sengetype' }}</span>
        <span class="bcw__nav-step">Trin 1 af 3</span>
      </div>
      <div class="bcw__nav-bar-right">
        <button class="bcw__nav-arrow bcw__nav-arrow--next" aria-label="Næste" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="9 6 15 12 9 18"/>
          </svg>
        </button>
      </div>
    </div>

  </div>{%- comment -%} /step-0 {%- endcomment -%}


  {%- comment -%}────────────────────────────────────────
    STEP 1 — Model Selection
  ────────────────────────────────────────{%- endcomment -%}
  <div class="bcw__step bcw__step--1" data-step="1" {% unless section.settings.skip_step0 %}hidden{% endunless %}>

    <div class="bcw__orb bcw__orb--tl"></div>
    <div class="bcw__orb bcw__orb--br"></div>

    <div class="bcw__step1-inner">

      <h2 class="bcw__heading">
        {{ section.settings.step1_heading | default: 'Vælg hvilken type seng ønsker I jer?' }}
      </h2>

      <div class="bcw__divider-wrap">
        <div class="bcw__divider-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 249.4 80.35" aria-hidden="true">
            <path fill="currentColor" d="M215.82,59.52V7.43c0-4.79-3.89-7.43-8.68-7.43H42.78c-4.79,0-8.68,2.64-8.68,7.43l-.06,36.98c5.83-.47,12.33-.75,19.57-.71v-13.33c0-5.99,4.86-10.84,10.84-10.84l44.72-.04c5.99,0,10.84,4.85,10.84,10.84v21.79c1.45.34,9.79,2.24,9.79,2.24v-23.99c0-5.99,4.85-10.84,10.84-10.84h44.75c5.99,0,10.84,4.86,10.84,10.84v30.88c7.27-.27,13.72-.91,19.57-1.74"/>
            <path fill="currentColor" d="M0,57.3v3.8s45.34-7.03,124.93,12.84c79.59,19.88,124.47-12.84,124.47-12.84v-3.8s-44.88,22.33-124.47,2.49C45.34,39.94,0,57.3,0,57.3"/>
          </svg>
        </div>
      </div>

      <div class="bcw__cards" role="group" aria-label="Vælg sengmodeller">
        {% for i in (1..5) %}
          {% assign prod_key   = 'product_' | append: i %}
          {% assign title_key  = 'product_title_' | append: i %}
          {% assign p          = section.settings[prod_key] %}
          {% assign override   = section.settings[title_key] %}
          {% if p != blank %}
            {% assign title = override | default: p.title %}
            <div
              class="bcw__card"
              data-index="{{ i }}"
              data-title="{{ title | escape }}"
              role="checkbox"
              aria-checked="false"
              tabindex="0"
            >
              <div class="bcw__card-img-wrap">
                {% if p.featured_image %}
                  <img
                    src="{{ p.featured_image | image_url: width: 480, height: 360, crop: 'center' }}"
                    alt="{{ title | escape }}"
                    width="480" height="360"
                    loading="lazy"
                    draggable="false">
                {% else %}
                  <div class="bcw__card-img-placeholder"></div>
                {% endif %}
                <div class="bcw__card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </div>
              </div>
              <span class="bcw__card-label">{{ title }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="bcw__step1-footer">
        <p class="bcw__hint" data-hint>Vælg op til 3 modeller</p>
        <button class="bcw__cta" data-cta disabled>
          {{ section.settings.cta_label | default: 'Sammenlign valgte' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
            <polyline points="9 6 15 12 9 18"/>
          </svg>
        </button>
      </div>

    </div>

    {%- comment -%} Bottom nav bar {%- endcomment -%}
    <div class="bcw__nav-bar">
      <div class="bcw__nav-bar-left">
        <button class="bcw__nav-arrow" aria-label="Tilbage"
          {% if section.settings.skip_step0 %}
            data-nav-back-url="{{ section.settings.step0_url | default: '/pages/sammenlign-kontinentalsenge' }}"
          {% else %}
            data-nav-back-to-0
          {% endif %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
      </div>
      <div class="bcw__nav-bar-center">
        <span class="bcw__nav-title">{{ section.settings.nav_title_1 | default: 'Sengemodel' }}</span>
        <span class="bcw__nav-step">Trin 2 af 3</span>
      </div>
      <div class="bcw__nav-bar-right">
        <button class="bcw__nav-arrow bcw__nav-arrow--next" aria-label="Næste" data-nav-next disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="9 6 15 12 9 18"/>
          </svg>
        </button>
      </div>
    </div>

  </div>{%- comment -%} /step-1 {%- endcomment -%}


  {%- comment -%}────────────────────────────────────────
    STEP 2 — Comparison Table
  ────────────────────────────────────────{%- endcomment -%}
  <div class="bcw__step bcw__step--2" data-step="2" hidden>

    <div class="bcw__step2-inner">

      <div class="bcw__step2-header">
        {% if section.settings.heading != blank %}
          <h2 class="comparison-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        <button class="bcw__back-btn" data-back>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Skift modeller
        </button>
      </div>

      {%- comment -%} Header cards {%- endcomment -%}
      <div class="comparison-table">
        <div class="row row--header">
          {% for i in (1..5) %}
            {% assign prod_key  = 'product_' | append: i %}
            {% assign title_key = 'product_title_' | append: i %}
            {% assign p         = section.settings[prod_key] %}
            {% assign override  = section.settings[title_key] %}
            {% if p != blank %}
              <div class="cell cell--product product-col product-{{ i }}">
                {% if section.settings.show_images and p.featured_image %}
                  <div class="product-thumb">
                    <img
                      src="{{ p.featured_image | image_url: width: 360, height: 360, crop: 'center' }}"
                      alt="{{ override | default: p.title | escape }}"
                      width="360" height="360" loading="lazy">
                  </div>
                {% endif %}
                <h3 class="product-title">{{ override | default: p.title }}</h3>
                <div class="product-price">
                  <span class="current">{{ p.price | money_without_trailing_zeros }}</span>
                  {% if p.compare_at_price > p.price %}
                    <span class="compare">{{ p.compare_at_price | money_without_trailing_zeros }}</span>
                  {% endif %}
                </div>
                <a href="{{ p.url }}" class="product-link">Læs mere</a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {%- comment -%} Per-product bullet blocks {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'product_bullets' %}
          <div class="row row--bullets" {{ block.shopify_attributes }}>
            {% if block.settings.bullets_heading != blank %}
              <div class="bullets-heading">{{ block.settings.bullets_heading }}</div>
            {% endif %}
            {% for i in (1..5) %}
              {% assign prod_key = 'product_' | append: i %}
              {% if section.settings[prod_key] != blank %}
                <div class="cell cell--product product-col product-{{ i }}">
                  <ul class="product-bullets">
                    {% for j in (1..3) %}
                      {% assign bullet_key = 'bullet_product_' | append: i | append: '_' | append: j %}
                      {% assign bullet = block.settings[bullet_key] %}
                      {% if bullet != blank %}
                        <li>{{ bullet | replace: 'xx', checkbox_icon }}</li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}

      {%- comment -%} Accordion comparison rows {%- endcomment -%}
      {% assign groups_str = "|" %}
      {% for block in section.blocks %}
        {% assign g      = block.settings.group | strip %}
        {% assign needle = "|" | append: g | append: "|" %}
        {% unless groups_str contains needle %}
          {% assign groups_str = groups_str | append: g | append: "|" %}
        {% endunless %}
      {% endfor %}
      {% assign groups_array = groups_str | split: "|" %}

      {% for g in groups_array %}
        {% if g != blank %}
          <details class="group-accordion" {% if section.settings.expand_first and forloop.first %}open{% endif %}>
            <summary class="group-summary">
              <span class="group-name">{{ g }}</span>
              <span class="group-toggle"></span>
            </summary>
            <div class="group-rows">
              {% for block in section.blocks %}
                {% assign bg = block.settings.group | strip | default: "Generelt" %}
                {% if bg == g %}
                  <div class="row" {{ block.shopify_attributes }}>
                    <div class="cell cell--label desktop-only">{{ block.settings.label }}</div>
                    {% for i in (1..5) %}
                      {% assign prod_key = 'product_' | append: i %}
                      {% if section.settings[prod_key] != blank %}
                        {% assign val_key = 'value_product_' | append: i %}
                        {% assign img_key = 'image_product_' | append: i %}
                        {% assign val     = block.settings[val_key] %}
                        {% assign val_img = block.settings[img_key] %}
                        <div class="cell cell--product product-col product-{{ i }}" data-label="{{ block.settings.label }}">
                          <div class="value-wrapper">
                            {% if val_img != blank %}
                              <div class="value-image">
                                <img
                                  src="{{ val_img | image_url: width: 420, height: 320, crop: 'center' }}"
                                  alt="{{ block.settings.label | escape }}"
                                  width="420" height="320" loading="lazy">
                              </div>
                            {% endif %}
                            {% if val != blank %}
                              <span class="value">{{ val }}</span>
                            {% else %}
                              <span class="value value--empty">&mdash;</span>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </details>
        {% endif %}
      {% endfor %}

      {%- comment -%} Shared equal bullets {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'product_bullets_equal' %}
          <div class="row row--bullets-equal" {{ block.shopify_attributes }}>
            <div class="cell cell--label">
              {% if block.settings.equal_bullets_heading != blank %}
                {{ block.settings.equal_bullets_heading }}
              {% endif %}
            </div>
            <div class="cell cell--equal">
              <ul class="product-bullets-equal">
                {% for i in (1..8) %}
                  {% assign bullet_key = 'equal_bullet_' | append: i %}
                  {% assign bullet = block.settings[bullet_key] %}
                  {% if bullet != blank %}
                    <li>{{ bullet | replace: 'xx', checkbox_icon }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
      {% endfor %}

    </div>{%- comment -%} /step2-inner {%- endcomment -%}

    <div class="bcw__nav-bar bcw__nav-bar--step2">
      <div class="bcw__nav-bar-left">
        <button class="bcw__nav-arrow" aria-label="Tilbage" data-back>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
      </div>
      <div class="bcw__nav-bar-center">
        <span class="bcw__nav-title">{{ section.settings.nav_title_2 | default: 'Sammenlign' }}</span>
        <span class="bcw__nav-step">Trin 3 af 3</span>
      </div>
      <div class="bcw__nav-bar-right">
        <button class="bcw__nav-arrow bcw__nav-arrow--next" aria-label="Næste" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <polyline points="9 6 15 12 9 18"/>
          </svg>
        </button>
      </div>
    </div>

  </div>{%- comment -%} /step-2 {%- endcomment -%}

</section>


{%- comment -%}══════════════════════════════════════════════════════════════
  STYLES
══════════════════════════════════════════════════════════════{%- endcomment -%}
<style>
/* ─── Design tokens ─────────────────────────────── */
#section-{{ section.id }} {
  --bcw-bg:          #1e0b03;
  --bcw-bg-card:     rgba(255,220,180,0.07);
  --bcw-bg-card-sel: rgba(232, 115, 74, 0.18);
  --bcw-border:      rgba(255,200,140,0.14);
  --bcw-border-sel:  #E8734A;
  --bcw-accent:      #E8734A;
  --bcw-accent-dim:  rgba(232, 115, 74, 0.18);
  --bcw-text:        #f5ede3;
  --bcw-text-muted:  rgba(245,237,227,0.5);
  --bcw-nav-bg:      rgba(18, 6, 1, 0.88);
  --bcw-radius-card: 18px;
  --bcw-radius-btn:  50px;
  --bcw-font:        'Vicky', 'Georgia', serif;

  /* Step 2 — dark warm (matches Step 1) */
  --cmp-bg:          rgba(255,200,140,0.08);
  --cmp-header-bg:   rgba(255,200,140,0.08);
  --cmp-border:      rgba(255,200,140,0.14);
  --cmp-accent:      #f09340;
  --cmp-text:        #f5ede3;
}

/* ─── Section wrapper ───────────────────────────── */
#section-{{ section.id }} {
  margin: 0;
  font-family: var(--bcw-font);
}

/* ─── Steps ─────────────────────────────────────── */
#section-{{ section.id }} .bcw__step {
  position: relative;
  overflow: hidden;
}

#section-{{ section.id }} .bcw__step--0,
#section-{{ section.id }} .bcw__step--1 {
  background: radial-gradient(ellipse at 50% 10%, #7a2d08 0%, #3d1204 35%, #1e0b03 70%);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 20px 120px;
}

#section-{{ section.id }} .bcw__step--2 {
  background: radial-gradient(ellipse at 50% 0%, #6a2506 0%, #3a1003 40%, #1e0b03 80%);
  padding: 40px 0 80px;
}

/* ─── Ambient orbs ───────────────────────────────── */
#section-{{ section.id }} .bcw__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  pointer-events: none;
  z-index: 0;
}
#section-{{ section.id }} .bcw__orb--tl {
  width: 420px; height: 420px;
  top: -80px; left: -100px;
  background: radial-gradient(circle, rgba(200,80,20,0.38) 0%, transparent 70%);
}
#section-{{ section.id }} .bcw__orb--br {
  width: 360px; height: 360px;
  bottom: 100px; right: -60px;
  background: radial-gradient(circle, rgba(160,50,10,0.28) 0%, transparent 70%);
}

/* ─── Step 1 inner layout ────────────────────────── */
#section-{{ section.id }} .bcw__step1-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 64px;
}

/* ─── Heading ────────────────────────────────────── */
#section-{{ section.id }} .bcw__heading {
  color: var(--bcw-text);
  font-size: clamp(1.35rem, 3vw, 2rem);
  font-weight: 400;
  text-align: center;
  letter-spacing: 0.01em;
  margin: 0 0 28px;
  line-height: 1.35;
}

/* ─── Divider bed icon ────────────────────────────── */
#section-{{ section.id }} .bcw__divider-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36px;
  position: relative;
}
#section-{{ section.id }} .bcw__divider-wrap::before {
  content: '';
  position: absolute;
  left: 0; right: 0;
  top: 50%;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(240,147,64,0.2) 20%, transparent 40%, transparent 60%, rgba(240,147,64,0.2) 80%, transparent 100%);
}
#section-{{ section.id }} .bcw__divider-icon {
  position: relative;
  z-index: 1;
  padding: 0 20px;
  background: transparent;
}
#section-{{ section.id }} .bcw__divider-icon svg {
  display: block;
  width: 72px;
  height: auto;
  color: #FEFDF9;
  filter: drop-shadow(0 0 8px rgba(101,8,34,0.4));
}

/* ─── Cards grid ─────────────────────────────────── */
#section-{{ section.id }} .bcw__cards {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  width: 100%;
  margin-bottom: 40px;
}

/* ─── Card ───────────────────────────────────────── */
#section-{{ section.id }} .bcw__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  width: calc(20% - 14px);
  min-width: 160px;
