<script>
(function () {
  'use strict';

  var root       = document.getElementById('section-{{ section.id }}');
  if (!root) return;

  /* ── DOM references ─────────────────────────────── */
  var step0      = root.querySelector('[data-step="0"]');
  var step1      = root.querySelector('[data-step="1"]');
  var step2      = root.querySelector('[data-step="2"]');

  var typeCards  = Array.from(root.querySelectorAll('.bcw__type-card'));
  var cards      = Array.from(root.querySelectorAll('.bcw__card:not(.bcw__type-card)'));
  var ctaBtn     = root.querySelector('[data-cta]');
  var hintEl     = root.querySelector('[data-hint]');
  var navNext    = root.querySelector('[data-nav-next]');
  var backBtns   = Array.from(root.querySelectorAll('[data-back]'));
  var navBackTo0 = root.querySelector('[data-nav-back-to-0]');

  var BREAKPOINT = 768;

  function getMaxSelect() {
    return window.innerWidth < BREAKPOINT ? 2 : 3;
  }

  var selectedOrder = [];

  /* ── Step visibility ─────────────────────────────── */
  function showStep(n) {
    [step0, step1, step2].forEach(function (s, i) {
      if (s) s.hidden = (i !== n);
    });
    window.scrollTo({ top: root.offsetTop - 20, behavior: 'smooth' });
  }

  /* ── Type card selection (Step 0) ───────────────── */
  typeCards.forEach(function (card) {
    function activate() {
      var type = card.getAttribute('data-type');
      var url  = card.getAttribute('data-url');

      /* Highlight selected card briefly */
      typeCards.forEach(function (c) { c.classList.remove('is-selected'); });
      card.classList.add('is-selected');

      setTimeout(function () {
        if (type === 'kontinental') {
          /* Go to model selection */
          showStep(1);
        } else if (url && url !== '') {
          /* Navigate to configured URL */
          window.location.href = url;
        } else {
          /* Fallback: no URL configured — do nothing / show hint */
          card.classList.remove('is-selected');
        }
      }, 220);
    }

    card.addEventListener('click', activate);
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
    });
  });

  /* ── Model card selection (Step 1) ──────────────── */
  function updateHint() {
    var max = getMaxSelect();
    var n   = selectedOrder.length;
    if (n === 0) {
      hintEl.textContent = 'Vælg op til ' + max + ' modeller';
      hintEl.classList.remove('is-limit');
    } else if (n >= max) {
      hintEl.textContent = 'Maksimalt ' + max + ' modeller valgt';
      hintEl.classList.add('is-limit');
    } else {
      hintEl.textContent = n + ' valgt — vælg op til ' + (max - n) + ' mere';
      hintEl.classList.remove('is-limit');
    }
  }

  function enforceLimit() {
    /* If screen shrinks to mobile while 3 are selected, deselect the last one */
    var max = getMaxSelect();
    while (selectedOrder.length > max) {
      var removedIdx = selectedOrder.pop();
      var removedCard = root.querySelector('.bcw__card[data-index="' + removedIdx + '"]');
      if (removedCard) {
        removedCard.classList.remove('is-selected');
        removedCard.setAttribute('aria-checked', 'false');
      }
    }
    updateHint();
    updateCTA();
  }

  function updateCTA() {
    var hasSelection = selectedOrder.length > 0;
    if (ctaBtn)  ctaBtn.disabled  = !hasSelection;
    if (navNext) navNext.disabled = !hasSelection;
  }

  function toggleCard(card) {
    var idx = card.getAttribute('data-index');
    var pos = selectedOrder.indexOf(idx);

    if (pos !== -1) {
      selectedOrder.splice(pos, 1);
      card.classList.remove('is-selected');
      card.setAttribute('aria-checked', 'false');
    } else {
      if (selectedOrder.length >= getMaxSelect()) {
        cards.forEach(function (c) {
          if (!c.classList.contains('is-selected')) {
            c.classList.remove('is-shaking');
            void c.offsetWidth;
            c.classList.add('is-shaking');
            c.addEventListener('animationend', function () {
              c.classList.remove('is-shaking');
            }, { once: true });
          }
        });
        return;
      }
      selectedOrder.push(idx);
      card.classList.add('is-selected');
      card.setAttribute('aria-checked', 'true');
    }

    updateHint();
    updateCTA();
  }

  /* ── Apply visibility to comparison columns ──────── */
  function applyComparisonVisibility() {
    root.querySelectorAll('.cell--product').forEach(function (c) {
      c.classList.remove('is-visible');
    });
    selectedOrder.forEach(function (idx, position) {
      root.querySelectorAll('.product-' + idx).forEach(function (c) {
        c.classList.add('is-visible');
        c.style.order = position;
      });
    });
  }

  /* ── Model card events ───────────────────────────── */
  cards.forEach(function (card) {
    card.addEventListener('click', function () { toggleCard(card); });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleCard(card); }
    });
  });

  /* ── CTA / nav transitions ───────────────────────── */
  if (ctaBtn) {
    ctaBtn.addEventListener('click', function () {
      if (selectedOrder.length === 0) return;
      applyComparisonVisibility();
      showStep(2);
    });
  }
  if (navNext) {
    navNext.addEventListener('click', function () {
      if (selectedOrder.length === 0) return;
      applyComparisonVisibility();
      showStep(2);
    });
  }
  backBtns.forEach(function (btn) {
    btn.addEventListener('click', function () { showStep(1); });
  });
  if (navBackTo0) {
    /* Step 1 back arrow → Step 0 (same page) */
    navBackTo0.addEventListener('click', function () { showStep(0); });
  }

  /* Step 1 back arrow → external URL (when skip_step0 is enabled) */
  var navBackUrl = root.querySelector('[data-nav-back-url]');
  if (navBackUrl) {
    navBackUrl.addEventListener('click', function () {
      window.location.href = navBackUrl.getAttribute('data-nav-back-url');
    });
  }

  /* ── Enforce limit on viewport resize ───────────── */
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(enforceLimit, 150);
  });

  /* ── Accordion: safety open on expand_first ──────── */
  {% if section.settings.expand_first %}
  var firstAcc = root.querySelector('.group-accordion');
  if (firstAcc && !firstAcc.hasAttribute('open')) {
    firstAcc.setAttribute('open', 'open');
  }
  {% endif %}

  /* ── Initial state ───────────────────────────────── */
  updateHint();
  updateCTA();

})();
</script>


