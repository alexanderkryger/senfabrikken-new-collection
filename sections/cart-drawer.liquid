<cart-drawer id="cart-drawer" class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %}" initial-focus="false" handle-editor-events>
  {% assign totalcount = 0 %}
  {% assign freeProducts = blank %}
  {% assign upsalePr = '' %}
  {%- assign freeProducts = freeProducts | split: ',' -%}
  {% for item_product in cart.items %}
    {% unless item_product.product.tags contains 'free_product' %}
      {% assign totalcount = totalcount | plus: item_product.quantity %}
    {% endunless %}
  {% endfor %}

  <p class="h4 cart-drawer-title" slot="header">{{ 'cart.general.title' | t }} ({{ totalcount }})</p>
{% if cart.item_count > 0 %}
  <a href="/cart/clear?return_to=/" class="button button--sm" style="margin: 0.5rem 0 1rem;">
    Slet hele kurven
  </a>
{% endif %}
    <!-- Leveringstid på mobil -->
{%- assign max_delivery_time = "" -%}
{%- assign max_days = 0 -%}

{%- for item in cart.items -%}
    {%- assign product_delivery_time = item.product.metafields.custom.leveringstid -%}
    {%- assign variant_delivery_time = item.variant.metafields.custom.ekstra_levering -%}

    {%- assign current_delivery_time = product_delivery_time -%}
    {%- assign current_max_days = product_delivery_time | split: '-' | last | remove: ' hverdage' | trim | plus: 0 -%}

    {%- if variant_delivery_time != blank -%}
        {%- assign current_delivery_time = variant_delivery_time -%}
        {%- assign current_max_days = variant_delivery_time | split: '-' | last | remove: ' hverdage' | trim | plus: 0 -%}
    {%- endif -%}

    {%- if max_days == 0 or current_max_days > max_days -%}
        {%- assign max_days = current_max_days -%}
        {%- assign max_delivery_time = current_delivery_time -%}
    {%- endif -%}
{%- endfor -%}

{%- if max_delivery_time != "" -%}
    <div class="cart-drawer-delivery-time" style="text-align: center; margin-top:20px;">
        <p>Leveringstid: {{ max_delivery_time }}</p>
    </div>
{%- endif -%}


  {%- if cart.empty? -%}
    <p class="h5 text-center">{{ 'cart.general.empty' | t }}</p>
  {%- else -%}
    {%- if settings.cart_show_free_shipping_bar -%}
      {%- render 'free-shipping-bar' -%}
    {%- endif -%}

    <div class="cart-drawer__items">
      {%- for line_item in cart.items -%}
        {%- for freeItem in line_item.product.metafields.custom.product_upsale_free.value -%}
            {%- assign freeProducts = freeProducts | append: freeItem.handle | append: ',' -%}
         {%- endfor -%}
         {%- for freeItem in line_item.product.metafields.custom.product_upsale_free_2.value -%}
            {%- assign freeProducts = freeProducts | append: freeItem.handle | append: ',' -%}
         {%- endfor -%}
        
        {% if line_item.product.tags contains "free_product" %}
          <div style="display: none;">
            {%- render 'line-item', line_item: line_item, show_quantity_selector: false -%}
          </div>
        {%- else -%}
          
        <div class="main-line-item">
          {% if line_item.product.metafields.custom.product_upsale.value != blank %}
            {% assign upsalePr = line_item %}
          {% endif %}
          {%- render 'line-item', line_item: line_item, show_quantity_selector: false, freeProducts:freeProducts -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>


    <form action="{{ routes.cart_url }}" method="POST" class="cart-drawer__footer" slot="footer">
      
    {% assign totalBeforePrice = 0 %}
                {% assign totalDiscount = 0 %}
                {% assign totalPrice = 0 %}

                {% for line_item in cart.items %}
                  {% assign lineFinalPrice = line_item.final_line_price %}
                  {% assign lineFullPrice = 0 %}
                  {% assign lineDiscount = 0 %}

                  {% unless line_item.product.type contains 'Free' %}
                    {% if line_item.variant.compare_at_price != blank %}
                      {% assign lineFullPrice = line_item.variant.compare_at_price | times: line_item.quantity %}
                    {% else %}
                      {% assign lineFullPrice = line_item.variant.price | times: line_item.quantity %}
                    {% endif %}
                    {% assign lineDiscount = lineFullPrice | minus: lineFinalPrice %}
                  {% else %}
                    {% assign lineFullPrice = lineFinalPrice %}
                  {% endunless %}

                  {% assign totalBeforePrice = totalBeforePrice | plus: lineFullPrice %}
                  {% assign totalDiscount = totalDiscount | plus: lineDiscount %}
                  {% assign totalPrice = totalPrice | plus: lineFinalPrice %}
                {% endfor %}
      <div class="">
        <div class="h-stack justify-between gap-2">
          <span class="text-lg cart-recap__total-styling">{{ 'cart.general.total' | t }}:</span>
          <span class="text-lg cart-recap__total-styling">{{- totalPrice | money_with_currency -}}</span>
        </div>
        {% unless totalDiscount == 0 %}
        <div class="h-stack justify-between gap-2">
          <span class="text-md cart-recap__discount-styling cart-recap__discount-styling--total">Din rabat</span>
          <span class="text-md cart-recap__discount-styling cart-recap__discount-styling--total">{{- totalDiscount | money_with_currency -}}</span>
        </div>
        {% endunless %}
      </div>

      <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
      <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

      {%- if section.settings.show_cart_note or section.settings.show_shipping_text -%}
        <div class="v-stack gap-0.5 justify-items-start">
          {%- if section.settings.show_cart_note -%}
            {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}
            <button class="link-faded-reverse" aria-controls="{{ cart_note_dialog_id }}">{{ 'cart.general.add_order_note' | t }}</button>

            <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
              <div class="form">
                <cart-note class="form-control">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%}
                </cart-note>

                <button type="button" class="button" is="dialog-close-button">{{ 'cart.general.save_note' | t }}</button>
              </div>
            </cart-note-dialog>
          {%- endif -%}

          {%- if section.settings.show_shipping_text -%}
            <p class="text-subdued">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% for discount_application in cart.cart_level_discount_applications %}
        <div class="h-stack justify-start gap-4">
          <span class="discount-badge text-xs">{%- render 'icon' with 'discount', width: 12 -%} {{- discount_application.title -}}</span>
          <span class="text-subdued">-{{ discount_application.total_allocated_amount | money }}</span>
        </div>
      {% endfor %}

      {% if settings.cart_agreement_checkbox %}
        <div class="checkbox-control cart-agreement">
          <input id="cart-agreement" type="checkbox" class="switch" name="cart-agreement" value="1" onClick="toggleCartAgreement()">
          <label for="cart-agreement" class="">{{ settings.cart_agreement_text }} <a href="{{ settings.cart_agreement_link }}" target="_blank">{{ settings.cart_agreement_link_text }}</a></label>
        </div>
      {% endif %}



      <div class="button-group">
        {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
          {%- assign view_cart = 'cart.general.view_cart' | t -%}
          {%- render 'button', href: routes.cart_url, content: view_cart, stretch: true -%}
        {%- endif -%}


        {%- if section.settings.show_checkout_button -%}
          {%- capture checkout_button -%}
            {{- 'cart.general.checkout' | t -}}

            {%- if section.settings.show_price_in_checkout_button -%}
              <span class="cart-drawer__button-price">{{- cart.total_price | money -}}</span>
            {%- endif -%}
          {%- endcapture -%}
          <div class="{% if settings.cart_agreement_checkbox %}agreement-control agreement-not-checked{% endif %} w-full">
            {%- render 'button', type: 'submit', content: checkout_button, name: 'checkout', stretch: true -%}
          </div>
        {%- endif -%}


      </div>

    </form>
  {%- endif -%}


  {%- if settings.payment_img != blank -%}
  <div class="cart-drawer-payment-icons" slot="payment-icons">
    <div class="payment-methods">
    <p class="footer-img"><img src="{{ settings.payment_img | img_url: '600x' }}" alt="{{ settings.logo.alt }}" style="max-width:{{settings.payimg-wd}}px; margin-top: 5px;" /></p>
    </div>
  </div>
  {%- endif -%}



  {% comment %}
  {%- if shop.enabled_payment_types.size > 0 -%}
    <div class="cart-drawer-payment-icons" slot="payment-icons">
      <div class="payment-methods">
        {%- for type in shop.enabled_payment_types -%}
          {{- type | payment_type_svg_tag -}}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  {% endcomment %}
  {%- render 'upsale-in-cart', upsalePr: upsalePr -%}
</cart-drawer>


<script type="text/javascript">
  function toggleCartAgreement(){
    agreed = document.getElementById("cart-agreement").checked;
    if(agreed){
    	document.querySelector(".agreement-control").classList.remove("agreement-not-checked");
    }else{
      	document.querySelector(".agreement-control").classList.add("agreement-not-checked");
    }
  }

</script>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "class": "shopify-section--cart-drawer",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.page_info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.free_shipping_bar_info"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.cart_drawer.show_cart_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "t:sections.cart_drawer.show_shipping_text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "t:sections.cart_drawer.show_view_cart_button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "t:sections.cart_drawer.show_checkout_button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_in_checkout_button",
      "label": "t:sections.cart_drawer.show_price_in_checkout_button",
      "default": true
    }
  ]
}
{% endschema %}
