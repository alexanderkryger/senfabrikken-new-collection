        },
        {
          "type": "url",
          "id": "hotspot_1_url",
          "label": "Url"
        },
        {
          "type": "range",
          "id": "hotspot_1_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal",
          "default": 51
        },
