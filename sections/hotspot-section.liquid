{%- if section.blocks.size > 0 -%}
  <div class="{% unless section.settings.remove_vertical_spacing %}section-spacing{% endunless %} {% if section.settings.background != blank and section.settings.background != 'rgba(0,0,0,0)' and section.settings.background != settings.background %}section-spacing--padded{% endif %} {% if section.settings.remove_padding %}section-spacing--padded-removed{% endif %}" style="{% render 'surface', background: section.settings.background, text_color: section.settings.text_color %}">
    <div class="container container-xl container-hotspot" style="background-image:url({{ 'dot-bg.svg' | asset_url }});">
      <div class="prose text-{{ section.settings.text_position }}">
        {%- assign is_inside_button_group_context = false -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'button' and is_inside_button_group_context == false -%}
            {%- assign is_inside_button_group_context = true -%}
            <div class="button-group justify-{{ section.settings.text_position }}">
          {%- elsif block.type != 'button' and is_inside_button_group_context -%}
            {%- assign is_inside_button_group_context = false -%}
            </div>
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- if block.settings.text != blank -%}
                <p class="{{ block.settings.heading_tag }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- endif -%}

            {%- when 'richtext' -%}
              {%- if block.settings.content != blank -%}
                  <div class="container container--sm">
                <div {{ block.shopify_attributes }}>
                  {{- block.settings.content -}}
                </div>
                </div>
              {%- endif -%}

            {%- when 'image' -%}
              {%- if block.settings.image != blank -%}
                <div class="hotspot-wrapper" {{ block.shopify_attributes }}>
                  {%- capture image_style_attribute -%}{% if section.settings.text_position == 'center' %}margin-inline: auto;{% elsif section.settings.text_position == 'end' %}margin-inline-start: auto;{% endif %}{%- endcapture -%}

                  {%- if block.settings.width_mode == 'custom' -%}
                    {%- capture image_style_attribute -%}{{ image_style_attribute }} --image-max-width: {{ block.settings.max_width }}px; --image-mobile-max-width: {{ block.settings.mobile_max_width }}px{%- endcapture -%}
                    {%- capture image_sizes_attribute -%}(max-width: 699px) min({{ block.settings.mobile_max_width }}px, 100vw), min({{ block.settings.max_width }}px, 100vw){%- endcapture -%}
                    {%- capture image_widths -%}{{ block.settings.mobile_max_width }},{{ block.settings.mobile_max_width | times: 2 }},{{ block.settings.max_width }},{{ block.settings.max_width | times: 2 }}{%- endcapture -%}
                  {%- else -%}
                    {%- capture image_sizes_attribute -%}min(100vw, var(--page-width)){%- endcapture -%}
                    {%- assign image_widths = '200,300,400,500,600,800,1000,1200,1400,1600' -%}
                  {%- endif -%}

                  {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: image_sizes_attribute, widths: image_widths, class: 'constrained-image hotspot-image', style: image_style_attribute -}}
                  <div class="hotspot-holder">
                    {%- if block.settings.hotspot_1_title != blank -%}
                    <a href="{{ block.settings.hotspot_1_url }}" class="hotspot hotspot-1">
                      <span class="hotspot-dot"></span><span class="hotspot-text">{{ block.settings.hotspot_1_title }}</span>
                    </a>
                    {%- endif -%}
                    {%- if block.settings.hotspot_2_title != blank -%}
                    <a href="{{ block.settings.hotspot_2_url }}" class="hotspot hotspot-2">
                      <span class="hotspot-dot"></span><span class="hotspot-text">{{ block.settings.hotspot_2_title }}</span>
                    </a>
                    {%- endif -%}
                    {%- if block.settings.hotspot_3_title != blank -%}
                    <a href="{{ block.settings.hotspot_3_url }}" class="hotspot hotspot-3">
                      <span class="hotspot-dot"></span><span class="hotspot-text">{{ block.settings.hotspot_3_title }}</span>
                    </a>
                    {%- endif -%}
                    {%- if block.settings.dimensions_1_title != blank -%}
                      <p class="dimensions dimensions-1">
                        <span></span><span class="dimensions-text">{{ block.settings.dimensions_1_title }}</span>
                      </p>
                      {%- endif -%}
                      {%- if block.settings.dimensions_2_title != blank -%}
                      <p class="dimensions dimensions-2">
                        <span></span><span class="height dimensions-text">{{ block.settings.dimensions_2_title }}</span>
                      </p>
                      {%- endif -%}
                      {%- if block.settings.dimensions_3_title != blank -%}
                      <p class="dimensions dimensions-3">
                        <span></span><span class="dimensions-text">{{ block.settings.dimensions_3_title }}</span>
                      </p>
                      {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
              <style>
              #shopify-section-{{ section.id }} .hotspot-1 {
                left: {{ block.settings.hotspot_1_horizontal }}%;
                top: {{ block.settings.hotspot_1_vertical }}%;
              }
              #shopify-section-{{ section.id }} .hotspot-2 {
                left: {{ block.settings.hotspot_2_horizontal }}%;
                top: {{ block.settings.hotspot_2_vertical }}%;
              }
              #shopify-section-{{ section.id }} .hotspot-3 {
                left: {{ block.settings.hotspot_3_horizontal }}%;
                top: {{ block.settings.hotspot_3_vertical }}%;
              }
              #shopify-section-{{ section.id }} .dimensions-1 {
                left: {{ block.settings.dimensions_1_horizontal }}%;
                top: {{ block.settings.dimensions_1_vertical }}%;
              }
              #shopify-section-{{ section.id }} .dimensions-2 {
                left: {{ block.settings.dimensions_2_horizontal }}%;
                top: {{ block.settings.dimensions_2_vertical }}%;
              }
              #shopify-section-{{ section.id }} .dimensions-3 {
                left: {{ block.settings.dimensions_3_horizontal }}%;
                top: {{ block.settings.dimensions_3_vertical }}%;
              }
              </style>

          {%- endcase -%}
        {%- endfor -%}
      </div>
 {%- if product.metafields.custom.dansk_produceret_kvalitetsseng_ikon != blank or product.metafields.custom.badge.value != blank -%}
        <div class="hotspot-icon">
          {%- if product.metafields.custom.dansk_produceret_kvalitetsseng_ikon != blank %}
            {% render 'icon' with 'dansk-kvalitet' %}
          {%- endif -%}

          {%- if product.metafields.custom.badges.value != blank -%}
          {% assign my_metaobject = product.metafields.custom.badges.value %}
            <img src="{{ my_metaobject.ikon.value | img_url }}" />
          {%- endif -%}
        {%- if product.metafields.custom.dansk_produceret_kvalitetsseng_ikon != blank %}
          {% render 'icon' with 'fsc' %} 
          {% render 'icon' with 'oeko' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}


{% schema %}
{
  "name": "Hotspot section",
  "class": "Hotspot section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "remove_padding",
      "label": "Remove bottom padding",
      "info": "If you use a background color, this makes the spacing more even",
      "default": false
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "t:global.position.content_position",
      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "center",
          "label": "t:global.position.center"
        },
        {
          "value": "end",
          "label": "t:global.position.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "t:global.spacing.remove_vertical_spacing",
      "default": false
    },
    {
      "type": "header",
      "content": "t:global.colors.category"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:global.colors.background"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich_text.blocks.heading.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:global.text.text",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:global.text.style",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "t:sections.rich_text.blocks.paragraph.name",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.rich_text.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:global.image.image",
          "info": "t:sections.rich_text.blocks.image.image_size_recommendation"
        },
        {
          "type": "radio",
          "id": "width_mode",
          "label": "t:global.image.width",
          "options": [
            {
              "value": "full_width",
              "label": "t:global.image.width_options.full_width"
            },
            {
              "value": "custom",
              "label": "t:global.image.width_options.custom"
            }
          ],
          "default": "custom"
        },
        {
          "type": "range",
          "id": "max_width",
          "min": 100,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "label": "t:global.image.maximum_width",
          "default": 600
        },
        {
          "type": "range",
          "id": "mobile_max_width",
          "min": 100,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "t:global.image.mobile_maximum_width",
          "default": 400
        },
        {
          "type": "header",
