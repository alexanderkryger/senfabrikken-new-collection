
{%- capture section_content -%}
  {%- for block in section.blocks -%}
  {%- if block.type == 'item' -%}


    <div class="text-with-icons__item" role="group">
      <div class="text-with-icons__item--flex">
        {%- if block.settings.custom_icon != blank -%}
          {%- capture sizes -%}15px{%- endcapture -%}
          {%- capture widths -%}15, {{ 15 | times: 2 | at_most: 15 }}{%- endcapture -%}
          {%- capture style -%}--image-mobile-max-width: 15px; --image-max-width: 15px{%- endcapture -%}
          {{- block.settings.custom_icon | image_url: width: 15 | image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: 'constrained-image', style: style -}}
        {%- else -%}
          <div style="{% render 'surface', text_color: section.settings.icon_color %}">
            {%- render 'icon' with block.settings.icon, width: 15, class: 'sm:hidden' -%}
            {%- render 'icon' with block.settings.icon, width: 15, class: 'hidden sm:block' -%}
          </div>
        {%- endif -%}

        {%- if block.settings.title != blank or block.settings.content != blank -%}
          <div class="">
            {%- if block.settings.title != blank -%}
              <p style="">{{ block.settings.title }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}


<div class="cart-page_bg">
  {%- if cart.empty? -%}
    <div class="container container--xs">
      <div class="empty-state">
        <div class="prose">
          <h1 class="h4">{{ 'cart.general.title' | t }}</h1>
          <p>{{ 'cart.general.empty' | t }}</p>

          {%- assign button_content = 'cart.general.continue_shopping' | t -%}
          {%- render 'button', content: button_content, href: settings.cart_empty_cart_link -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="container">
      <div class="section-stack">
        {% comment %} <div class="section-header justify-self-center text-center">
          <div class="v-stack gap-4">
            <h1 class="h2">{{ 'cart.general.title' | t }}</h1>

            {%- if settings.cart_show_free_shipping_bar -%}
              {%- render 'free-shipping-bar' -%}
            {%- endif -%}
          </div>
        </div> {% endcomment %}

        <form action="{{ routes.cart_url }}" method="POST" class="cart-page">
          <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
          <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

          <div class="v-stack gap-6 order-summary-padding">
            {%- comment -%}
            ----------------------------------------------------------------------------------------------------------------
            ORDER SUMMARY
            ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <div class="order-summary__wrapper">
            {% assign totalcount = 0 %}
            {% for item_product in cart.items %}
              {% unless item_product.product.tags contains 'free_product' %}
                {% assign totalcount = totalcount | plus: item_product.quantity %}
              {% endunless %}
            {% endfor %}
                    <h1 class="h2">{{ 'cart.general.title' | t }} ({{ totalcount }} varer)</h1>
            <a href="/cart/clear" class="button button--sm" style="margin-top: 0.5rem; margin-bottom: 1rem;">
  Slet hele kurven
</a>
            <table class="order-summary table--reduce-border">
              <thead class="order-summary__header">

              </thead>

              <tbody class="order-summary__body">
                    {% assign counter = 0 %}

      {% assign mains = blank %}
      {% assign orders = blank %}
      {% assign freeProducts = blank %}
      {% assign mainKey = blank %}

      {%- for item in cart.items -%}
      	{%- if item.product.tags contains 'main' -%}
          {%- assign mains = mains | append: item.properties._ref | append: ',' -%}
          {%- assign orders = orders | append: counter | append: ',' -%}
      	  {%- assign counter = counter | plus: 10 -%}
          {% assign mainKey = item.properties._ref %}
      	{%- endif -%}
      {%- endfor -%}

      {% assign mains = mains | split: ',' %}
      {% assign orders = orders | split: ',' %}
      {% assign sorted = cart.items | sort: 'item.properties._ref' %}
      {%- assign freeProducts = freeProducts | split: ',' -%}

      {%- for item in sorted -%}

      	{%- capture props -%}
          {%- for p in item.properties -%}
            {%- if p.first == "main" -%}
              {{- p.last -}}
            {% endif -%}
          {%- endfor -%}
        {%- endcapture -%}

      	{%- assign order = 0 -%}
      	{%- for main in mains -%}
      	  {% if main == item.properties._ref %}
      		  {%- assign order = orders[forloop.index0] | plus: 1 -%}
      		  {% break %}
      	  {% endif %}
      	{%- endfor -%}

         {%- for freeItem in item.product.metafields.custom.product_upsale_free.value -%}
            {%- assign freeProducts = freeProducts | append: freeItem.handle | append: ',' -%}
         {%- endfor -%}
         {%- for freeItem in item.product.metafields.custom.product_upsale_free_2.value -%}
            {%- assign freeProducts = freeProducts | append: freeItem.handle | append: ',' -%}
         {%- endfor -%}
        

                  <tr class="{% if item.product.tags contains 'main' %}main-product-item{% elsif item.product.tags contains 'free_product' %}additional-product-item{% elsif freeProducts contains item.product.handle %}additional-product-item freeItem{% endif %} js-cartItem"
                    {% if item.product.tags contains 'main' %}data-id="{{ item.product.id }}" data-main-id="{{ product.selected_or_first_available_variant.key }}"{% endif %}
                    {% if item.product.tags contains 'free_product' or freeProducts contains item.product.handle %}data-prop="{{ prop }}"{% endif %}
                    data-uid="{{ mainKey }}">
                    <td>
                      {%- render 'line-item', line_item: item, show_quantity_selector: false, freeProducts:freeProducts -%}
                    </td>

                    {% unless item.product.tags contains 'free_product' or item.product.tags contains 'main' or item.product.tags contains 'gift_product' %}
                      <td class="quantity-td">
                        <line-item-quantity class="v-stack justify-items-center gap-2">
                          {%- render 'quantity-selector', line_item: item, size: 'sm', add_updates: true -%}
                          {% comment %} <a href="{{ item.url_to_remove }}" class="link text-xs">{{ 'cart.order.remove' | t }}</a> {% endcomment %}
                        </line-item-quantity>
                      </td>
                      {% else %}
                      <td>
                          
                      </td>
                    {% endunless %}
                    {% comment %} <td class="text-end">
                      {%- if settings.currency_code_enabled -%}
                        {{- item.final_line_price | money_with_currency -}}
                      {%- else -%}
                        {{- item.final_line_price | money -}}
                      {%- endif -%}
                    </td> {% endcomment %}
                    <td>
                    {% if item.product.tags contains 'main' and item.properties._ref != blank %}

                    <a href="/cart/change?id={{ item.key }}&amp;quantity=0" title="{{ 'cart.general.remove' | t }}"
                      class="btn cart__remove js-mainProductRemove">
                      {%- render 'icon' with 'trash' -%}
                    </a>
                    {% else %}
                    <a href="{{ item.url_to_remove }}" title="{{ 'cart.general.remove' | t }}"
                      class="btn cart__remove">
                      {%- render 'icon' with 'trash' -%}
                    </a>
                    {%- endif -%}
                    {% comment %} {%- if is_free_product -%}
                      <button type="button" class="cart__edit-button js-freeProductSelectionBtn" data-key="{{ item.key }}">

                        <span>Luk add-on</span>
                      </button>
                    {%- endif -%} {% endcomment %}
                    </td>
                  </tr>

                {%- endfor -%}
              </tbody>
            </table>


 {%- for block in section.blocks -%}
  {%- if block.type == 'banner' -%}
    <div class="cart-page__recap-banner">
    {%- if block.settings.custom_image != blank -%}
          {{- block.settings.custom_image | image_url: width: 75 | image_tag: loading: 'lazy', class: 'constrained-image', style: style -}}
    {%- endif -%}
    <div class="cart-page__recap-banner__text-flex">
      {% if block.settings.short_text != blank %}
        <div class="cart-page__recap-banner__short">
        <p>{{ block.settings.short_text }}</p>
        </div>
      {%- endif -%}
      {% if block.settings.title != blank %}
        <div class="cart-page__recap-banner__long">
        <h3>{{ block.settings.title }}</h3>
        </div>
      {%- endif -%}
    </div>
    </div>
  {%- endif -%}
  {%- if block.type == 'leveringstid' -%}
    <div class="cart-page__recap-banner">
    {%- if block.settings.custom_image != blank -%}
        {{- block.settings.custom_image | image_url: width: 75 | image_tag: loading: 'lazy', class: 'constrained-image', style: style -}}
    {%- endif -%}
    <div class="cart-page__recap-banner__text-flex">
        {% if block.settings.title != blank %}
            <div class="cart-page__recap-banner__long">
                <h3>Leveringstid</h3>
            </div>
        {%- endif -%}
        {% if block.settings.short_text != blank %}
            <div class="cart-page__recap-banner__short">
                {%- assign max_delivery_time = "" -%}
                {%- assign max_days = 0 -%}

                {%- for item in cart.items -%}
                    {%- assign product_delivery_time = item.product.metafields.custom.leveringstid -%}
                    {%- assign variant_delivery_time = item.variant.metafields.custom.ekstra_levering -%}

                    {%- assign current_delivery_time = product_delivery_time -%}
                    {%- assign current_max_days = product_delivery_time | split: '-' | last | remove: ' hverdage' | trim | plus: 0 -%}

                    {%- if variant_delivery_time != blank -%}
                        {%- assign current_delivery_time = variant_delivery_time -%}
                        {%- assign current_max_days = variant_delivery_time | split: '-' | last | remove: ' hverdage' | trim | plus: 0 -%}
                    {%- endif -%}

                    {%- if max_days == 0 or current_max_days > max_days -%}
                        {%- assign max_days = current_max_days -%}
                        {%- assign max_delivery_time = current_delivery_time -%}
                    {%- endif -%}
                {%- endfor -%}

                {%- if max_delivery_time != "" -%}
                    <p>Leveringstid: {{ max_delivery_time }}</p>
                {%- endif -%}
            </div>
        {%- endif -%}
    </div>
    </div>
{%- endif -%}
{%- endfor -%}



            </div>
          <div class="cart-page__sidebar">
            {%- comment -%}
            ----------------------------------------------------------------------------------------------------------------
            CART FOOTER
            ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <div class="cart-footer">

              <div class="cart-recap">
                {%- comment -%}Give apps a special hook to add features on the recap (such as capturing delivery dates){%- endcomment -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == '@app' -%}
                    {%- render block -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if section.settings.show_order_weight -%}
                  <div class="h-stack justify-between gap-2">
                    <span class="text-subdued">{{ 'cart.general.weight' | t }}:</span>
                    <span class="text-subdued">{{ cart.total_weight | weight_with_unit }}</span>
                  </div>
                {%- endif -%}

                {%- if cart.items_subtotal_price != cart.total_price -%}
                  <div class="h-stack justify-between gap-2">
                    <span class="text-subdued">{{ 'cart.general.subtotal' | t }}:</span>
                    <span class="text-subdued">
                      {%- if settings.currency_code_enabled -%}
                        {{- cart.items_subtotal_price | money_with_currency -}}
                      {%- else -%}
                        {{- cart.items_subtotal_price | money -}}
                      {%- endif -%}
                    </span>
                  </div>
                {%- endif -%}

                {% for discount_application in cart.cart_level_discount_applications %}
                  <div class="h-stack justify-between gap-2">
                    <span class="discount-badge text-xs">{%- render 'icon' with 'discount', width: 12 -%} {{- discount_application.title -}}</span>
                    <span class="text-subdued">-{{ discount_application.total_allocated_amount | money }}</span>
                  </div>
                {% endfor %}

                {% assign totalBeforePrice = 0 %}
                {% assign totalDiscount = 0 %}
                {% assign totalPrice = 0 %}

                {% for line_item in cart.items %}
                  {% assign lineFinalPrice = line_item.final_line_price %}
                  {% assign lineFullPrice = 0 %}
                  {% assign lineDiscount = 0 %}

                  {% unless line_item.product.type contains 'Free' %}
                    {% if line_item.variant.compare_at_price != blank %}
                      {% assign lineFullPrice = line_item.variant.compare_at_price | times: line_item.quantity %}
                    {% else %}
                      {% assign lineFullPrice = line_item.variant.price | times: line_item.quantity %}
                    {% endif %}
                    {% assign lineDiscount = lineFullPrice | minus: lineFinalPrice %}
                  {% else %}
                    {% assign lineFullPrice = lineFinalPrice %}
                  {% endunless %}

                  {% assign totalBeforePrice = totalBeforePrice | plus: lineFullPrice %}
                  {% assign totalDiscount = totalDiscount | plus: lineDiscount %}
                  {% assign totalPrice = totalPrice | plus: lineFinalPrice %}
                {% endfor %}

                {% unless totalDiscount == 0 %}
                <div class="h-stack justify-between gap-2">
                  <span class="text-md">Pris før udsalg</span>
                  <span class="text-md">{{- totalBeforePrice | money_with_currency -}}</span>
                </div>
                <div class="h-stack justify-between gap-2">
                  <span class="text-md cart-recap__discount-styling">Din besparelse</span>
                  <span class="text-md cart-recap__discount-styling">{{- totalDiscount | money_with_currency -}}</span>
                </div>
                {% endunless %}
                <div class="h-stack justify-between gap-2">
                  <span class="text-md">Subtotal</span>
                  <span class="text-md">{{- totalPrice | money_with_currency -}}</span>
                </div>
                <div class="h-stack justify-between gap-2">
                  <span class="text-md">Moms udgør</span>
                  <span class="text-md">{{- totalPrice | times: 0.2 | round | money_with_currency -}}</span>
                </div>
                <div class="h-stack justify-between gap-2">
                  <span class="text-lg cart-recap__total-styling">{{ 'cart.general.total' | t }}:</span>
                  <span class="text-lg cart-recap__total-styling ctotal">{{- totalPrice | money_with_currency -}}</span>
                </div>
                {% unless totalDiscount == 0 %}
                <div class="h-stack justify-between gap-2">
                  <span class="text-md cart-recap__discount-styling cart-recap__discount-styling--total">Din rabat</span>
                  <span class="text-md cart-recap__discount-styling cart-recap__discount-styling--total">{{- totalDiscount | money_with_currency -}}</span>
                </div>
              {% endunless %}
                {%- if section.settings.show_shipping_text -%}
                  <div class="taxes-shipping-text">
                    {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                      <p class="text-subdued text-sm">{{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}</p>
                    {%- elsif cart.taxes_included -%}
                      <p class="text-subdued text-sm">{{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}</p>
                    {%- elsif shop.shipping_policy.body != blank -%}
                      <p class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}</p>
                    {%- else -%}
                      <p class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {% if settings.cart_agreement_checkbox %}
                  <div class="checkbox-control cart-agreement">
                    <input id="cart-agreement_cartpage" type="checkbox" class="switch" name="cart-agreement_cartpage" value="1" onClick="toggleCartAgreementCartPage()" autocomplete="off">
                    <label for="cart-agreement_cartpage" class="">{{ settings.cart_agreement_text }} <a href="{{ settings.cart_agreement_link }}" target="_blank">{{ settings.cart_agreement_link_text }}</a></label>
                  </div>
                {% endif %}

                <div class="{% if settings.cart_agreement_checkbox %}agreement-control_cartpage agreement-not-checked{% endif %}">
                <div class="cart__buttons">
                {%- if section.settings.show_accelerated_payment_buttons and additional_checkout_buttons -%}
                  <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                    {{- content_for_additional_checkout_buttons -}}
                  </div>
                {% endif %}

                <noscript>
                  {%- assign update_button = 'cart.general.update_cart' | t -%}
                  {%- render 'button', type: 'submit', content: update_button, style: 'outline' -%}
                </noscript>

                {%- assign checkout_button = 'cart.general.checkout' | t -%}
                {%- render 'button', type: 'submit', content: checkout_button, name: 'checkout' -%}
              </div>







              </div>
              <div class="split-payment-wrapper">
