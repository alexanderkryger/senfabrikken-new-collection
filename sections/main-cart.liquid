<script type="text/javascript">
  function toggleCartAgreementCartPage(){
    agreedCartPage = document.getElementById("cart-agreement_cartpage").checked;
    if(agreedCartPage){
    	document.querySelector(".agreement-control_cartpage").classList.remove("agreement-not-checked");
    }else{
      	document.querySelector(".agreement-control_cartpage").classList.add("agreement-not-checked");
    }
  }
window.addEventListener('DOMContentLoaded',function(){

    function removeMainProduct(removeBtn) {
    var mainUid = $(removeBtn).parents('.js-cartItem').attr('data-uid');
    var updateObj = {};

    $.getJSON('/cart.js')
    .done(function(cart) {
      var items = cart.items;

      $(items).each(function(index) {
        var itemKey = $(this)[0].key;
        var itemProps = $(this)[0].properties;
        var isEmpty;

        if (!itemProps) return

        var hasVal = Object.keys(itemProps).includes('_ref');
        var propVal = itemProps._ref;

        var isFreeProduct = propVal === mainUid;

        if (isFreeProduct) {
          updateObj[itemKey] = 0;
        }
      })

      fetch('/cart/update.js', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          updates: updateObj
        })
      })
      .then(function() {
        location.reload();
      })
    });
  }

  function toggleFreeProductSelection(key) {
    var selection = Array.from(document.querySelectorAll('.js-freeProductSelection')).find(function(s) {
      return s.dataset.key === key;
    });
    //selection.hidden = !selection.hidden;
  }

  function getRelatedVariant(item) {
    var key = item.dataset.key;
    var parent = item.closest('[data-item]');
    var script = parent.querySelector('script[id="' + key + '"]')
    var json = JSON.parse(script.innerHTML)

    var currentSelection = item.dataset.variantOptions.split(',')
    var findVariant = json.find(function(variant) {
      if ( JSON.stringify(variant.options) === JSON.stringify(currentSelection) ) {
        return true;
      }
    })

    if ( findVariant ) return findVariant;
    else return false;
  }


  setTimeout(function() {
    $('.js-freeProductSelectionItem').each(function(index, item) {
      if ( !item.hasAttribute('data-variant-id') ) {
        var variant = getRelatedVariant(item);

        var price = item.querySelector('.cart__price-wrapper')
        var priceDifference = variant.price - variant.currentPrice
        price.textContent = Shopify.formatMoney(priceDifference, theme.moneyFormat);
      }
    })
  }, 400);

  function updateFreeProduct(item) {
    var key = item.dataset.key;
    var variantId = item.dataset.variantId ?? getRelatedVariant(item)?.id.toString();
    var qty = parseInt(item.dataset.qty, 10);
    var mainTitle = item.dataset.main;
    var position = item.dataset.position;
    var ref = item.closest('.js-cartItem').dataset.uid;

    var imageUrl = item.dataset.imageUrl;

    fetch('/cart/update.js', {
      method: 'POST',
      credentials: 'include',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        updates: {
          [key]: 0
        }
      })
    })
    .then(function() {
      fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            id: variantId,
            quantity: qty,
            properties: {
              'main': mainTitle,
              '_ref': ref
            }
        })
      })
      .then(function(response) {
        return response.json();
      })
      .then(function(data) {
        location.reload();
      })
    });
  }

  $(document).ready(function(){
  	$(".js-mainProductRemove").on("click", function(event){
      event.preventDefault();
      removeMainProduct(this);
    });

    $('.js-freeProductSelectionBtn').on('click', function(event) {
      var btn = event.currentTarget;
      var key = btn.dataset.key;
      btn.hidden = true;
      toggleFreeProductSelection(key);
    });

    $('.js-freeProductSelectionItem').on('click', function(event) {
      var item = event.currentTarget;
      updateFreeProduct(item);
    });
  });
});
</script>

