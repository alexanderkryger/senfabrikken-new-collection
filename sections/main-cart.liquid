                 {%- endif -%}
              {% comment %} TEST af payment scripts {% endcomment %}
              {%- if settings.payment_img != blank -%}
              <div class="cart-drawer-payment-icons" slot="payment-icons">
                <div class="payment-methods">
                <p class="footer-img"><img src="{{ settings.payment_img | img_url: '600x' }}" alt="{{ settings.logo.alt }}" style="max-width:250px; margin-top: 5px;" /></p>
                </div>
              </div>
              {%- endif -%}
              {% comment %}
              {%- if shop.enabled_payment_types.size > 0 -%}
                <div class="payment-methods">
                  {%- for type in shop.enabled_payment_types -%}
                    {{- type | payment_type_svg_tag -}}
