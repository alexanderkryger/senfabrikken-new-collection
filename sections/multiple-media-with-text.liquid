{%- if section.blocks.size > 0 -%}
  {%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  CSS
  ------------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <style>
    #shopify-section-{{ section.id }} {
      --multiple-media-with-text-grid: {% if section.settings.media_position_mobile == 'before_text' %}"media-wrapper" "content-wrapper"{% else %}"content-wrapper" "media-wrapper"{% endif %} / minmax(0, 1fr);
      --multiple-media-with-text-media-alignment-offset: {{ section.settings.media_mobile_alignment_offset }}px;
      --multiple-media-with-text-media-grid: auto var(--multiple-media-with-text-media-grid-auto-rows) / auto-flow var(--multiple-media-with-text-media-grid-auto-columns);
      --multiple-media-with-text-media-gap: {% if section.settings.media_layout == 'overlap' %}0{% else %}0.5rem{% endif %};

      {%- capture grid_auto_rows -%}
        {%- if section.blocks.size > 1 -%}
          {%- if section.settings.media_alignment == 'start' -%}
            [offset-start] minmax(0, var(--multiple-media-with-text-media-alignment-offset)) [offset-end main-start] minmax(0, 1fr) [main-end]
          {%- elsif section.settings.media_alignment == 'end' -%}
            [main-start] minmax(0, 1fr) [main-end offset-start] minmax(0, var(--multiple-media-with-text-media-alignment-offset)) [offset-end]
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- capture grid_auto_columns -%}
        {%- if section.settings.media_layout == 'overlap' -%}
          minmax(0, 1.75fr) minmax(0, 0.8fr) minmax(0, 0.8fr)
        {%- else -%}
          minmax(0, 1fr)
        {%- endif -%}
      {%- endcapture -%}

      --multiple-media-with-text-media-grid-auto-rows: {{- grid_auto_rows -}};
      --multiple-media-with-text-media-grid-auto-columns: {{- grid_auto_columns -}};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --multiple-media-with-text-media-alignment-offset: {{ section.settings.media_alignment_offset }}px;
        --multiple-media-with-text-media-gap: {% if section.settings.media_layout == 'overlap' %}0{% else %}0.625rem{% endif %};

        {%- capture grid_auto_columns -%}
          {%- if section.settings.media_layout == 'overlap' -%}
            {%- if section.settings.media_position_desktop == 'before_text' -%}
              minmax(0, 1.85fr) minmax(0, 0.35fr) minmax(0, 1.4fr)
            {%- else -%}
              minmax(0, 1.4fr) minmax(0, 0.35fr) minmax(0, 1.85fr)
            {%- endif -%}
          {%- else -%}
            minmax(0, 1fr) minmax(0, 1fr)
          {%- endif -%}
        {%- endcapture -%}

        --multiple-media-with-text-media-grid-auto-columns: {{- grid_auto_columns -}};
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --multiple-media-with-text-grid: {% if section.settings.media_position_desktop == 'before_text' %}"media-wrapper content-wrapper" / minmax(0, 1fr) minmax(0, 375px){% else %}"content-wrapper media-wrapper" / minmax(0, 375px) minmax(0, 1fr){% endif %};
      }
    }

    #shopify-section-{{ section.id }} #info-card-1 {
      color: {{ section.settings.content_color }};
    }

    #shopify-section-{{ section.id }} #info-card-2 {
      color: {{ section.settings.content_below_color }};
    }

    {% if section.settings.content_border_top -%}
    #shopify-section-{{ section.id }} #info-card-1 {
      border-top: 1px solid {{ section.settings.content_border_color }};
      padding-top: 24px;

    }
    {%- endif -%}

    {% if section.settings.content_border_bottom -%}
    #shopify-section-{{ section.id }} #info-card-1 {
      border-bottom: 1px solid {{ section.settings.content_border_color }};
      padding-bottom: 24px;
    }
    {%- endif -%}

    {% if section.settings.content_border_below_top -%}
    #shopify-section-{{ section.id }} #info-card-2 {
      border-top: 1px solid {{ section.settings.content_border_below_color }};
      padding-top: 24px;

    }
    {%- endif -%}

    {% if section.settings.content_border_below_bottom -%}
    #shopify-section-{{ section.id }} #info-card-2 {
      border-bottom: 1px solid {{ section.settings.content_border_below_color }};
      padding-bottom: 24px;
    }
    {%- endif -%}


  </style>

  {%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div{% if section.settings.custom_id != blank %} id="{{ section.settings.custom_id }}"{% endif %} class="section-spacing {% if section.settings.background != blank and section.settings.background != 'rgba(0,0,0,0)' and section.settings.background != settings.background %}section-spacing--padded{% endif %}" style="{% render 'surface', background: section.settings.background, text_color: section.settings.text_color %}">
    <div class="container container--xl">
      <multiple-media-with-text {% if section.settings.reveal_on_scroll %}reveal-on-scroll="true"{% endif %} class="multiple-media-with-text {% if section.settings.media_layout == 'overlap' %}multiple-media-with-text--overlap{% endif %} {% if section.settings.media_position_desktop == 'after_text' %}multiple-media-with-text--reverse{% endif %}">
        <div class="multiple-media-with-text__media-wrapper">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }} class="align-self-{{ section.settings.media_alignment }}" style="--media-rotate: {{ block.settings.rotation }}deg; {% if forloop.first %}{% if section.settings.media_alignment == 'start' %}grid-row-start: offset-end;{% elsif section.settings.media_alignment == 'end' %}grid-row-end: main-end;{% endif %}{% endif %}">
                {%- if block.settings.hide_mobile -%}
                {% capture hide_mobile %}sm-max:hidden{% endcapture %}
                {%- endif -%}
              {%- if block.type == 'image' and block.settings.image -%}
                {%- capture sizes_attribute -%}(max-width: 699px) 50vw, 500px{%- endcapture -%}
                {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,800,1000,1200', class: hide_mobile -}}
              {%- elsif block.type == 'video' and block.settings.video -%}
                {%- render 'media', media: block.settings.video, autoplay: true, loop: true, class: hide_mobile -%}
              {%- else -%}
                {%- capture placeholder -%}collection-{{ forloop.index }}{%- endcapture -%}
                {%- capture placeholder_class -%}{% cycle 'placeholder', 'placeholder placeholder--invert' %}{%- endcapture -%}
                {{- placeholder | placeholder_svg_tag: placeholder_class -}}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="align-self-{{ section.settings.media_alignment }}">
              {{- 'collection-1' | placeholder_svg_tag: 'placeholder' -}}
            </div>

            <div class="align-self-{{ section.settings.media_alignment }}">
              {{- 'collection-2' | placeholder_svg_tag: 'placeholder placeholder--invert' -}}
            </div>
          {%- endfor -%}
        </div>

          <div>
          {%- if section.settings.image or section.settings.video -%}
          <div class="multiple-media-above-content {% if section.settings.hide_mobile %}sm-max:hidden{% endif %}">
            {%- if section.settings.image -%}
              {%- capture sizes_attribute -%}(max-width: 699px) 50vw, 500px{%- endcapture -%}
              {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,800,1000,1200' -}}
              {%- endif -%}
            {%- if section.settings.video -%}
              {%- render 'media', media: section.settings.video, autoplay: true, loop: true -%}
            {%- endif -%}
          </div>
          {%- endif -%}

          <div class="multiple-media-with-text__content-wrapper align-self-{{ section.settings.text_alignment }}">
            <div class="prose info-card-wrapper">
              {%- if section.settings.subheading != blank -%}
                <p class="h6">{{ section.settings.subheading }}</p>
              {%- endif -%}

              {%- if section.settings.title != blank -%}
              <div class="info-card-title-and-icon">
                <p class="h3">{{ section.settings.title }}</p>
                {%- if section.settings.show_icon -%}
                  {% render 'icon' with 'dansk-kvalitet' %}
                {%- endif -%}
              </div>
              {%- endif -%}

              {%- if section.settings.show_color_swatch != blank -%}

              <div class="h-stack wrap gap-2" style="margin-block-start: 0;">
                <div class="color-swatch__title">
                  Farver
                </div>
                <div class="color-swatch-wrapper">
                  {% for mProducts in product.metafields.my_fields.mcolors.value %}
                  {% assign farveObject =  mProducts.metafields.custom.farve_filter.value %}
                    <a href="{{ mProducts.url | within: collection }}" class="{% if product.url == mProducts.url %}is-current-page{% endif %}">
                      <label class="color-swatch {% if white_label == value_downcase %}border{% endif %}" for="{{ id | escape }}" data-option-value style="background-color: {{ farveObject.swatch.value }};">
                        <span class="sr-only">{{ farveObject.swatch.value }}</span>
                      </label>
                      <span class="color-swatch-label {% if farveObject.farve_navn.value == 'Hvid' %}color-swatch-white{% endif %}">{{ farveObject.farve_navn.value }}</span>
                    </a>
                  {% endfor %}
                </div>
              </div>
              {%- endif -%}


              {%- if section.settings.content != blank -%}
              <div id="info-card-1" class="info-card-content">
                {{- section.settings.content -}}
              </div>
              {%- endif -%}

              {%- if section.settings.content_below != blank -%}
              <div id="info-card-2" class="info-card-content">
                {{- section.settings.content_below -}}
              </div>
              {%- endif -%}

              {%- if section.settings.telefon != blank or section.settings.email != blank or section.settings.chat != blank -%}
              <div id="info-card-2" class="info-card-content">
                <span>
                  {% render 'icon' with 'phone' %} {{- section.settings.telefon -}} &nbsp;&nbsp;{{ section.settings.telefon_sub }}
                </span>
                <span>
                  {% render 'icon' with 'email' %} {{- section.settings.email -}}
                </span>
                <span>
                  {% render 'icon' with 'chat' %} {{- section.settings.chat -}}
                </span>
              </div>
              {%- endif -%}

              {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
                <div class="button-group">
                  {%- if section.settings.button_1_text != blank -%}
                    {%- render 'button', href: section.settings.button_1_link, content: section.settings.button_1_text, style: section.settings.button_1_style, background: section.settings.button_background, text_color: section.settings.button_text_color -%}
                  {%- endif -%}

                  {%- if section.settings.button_2_text != blank -%}
                    {%- render 'button', href: section.settings.button_2_link, content: section.settings.button_2_text, style: section.settings.button_2_style, background: section.settings.button_background, text_color: section.settings.button_text_color -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </multiple-media-with-text>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
