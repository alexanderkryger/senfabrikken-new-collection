{% assign checkbox_icon = '<svg class="icon-check" viewBox="0 0 16 16" fill="currentColor"><path d="M6.0 11.0l-3.5-3.5 1.5-1.5L6.0 8.0l6.0-6.0 1.5 1.5z"/></svg>' %}
<section id="section-{{ section.id }}" class="comparison-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="comparison-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {%- comment -%} Collect configured products (indices + titles) {%- endcomment -%}
    {% assign products = '' %}
    {% for i in (1..6) %}
      {% assign key = 'product_' | append: i %}
      {% assign title_key = 'product_title_' | append: i %}
      {% assign p = section.settings[key] %}
      {% assign override = section.settings[title_key] %}
      {% if p != blank %}
        {% assign title = override | default: p.title %}
        {% assign products = products | append: i | append: ':' | append: title | append: '||' %}
      {% endif %}
    {% endfor %}
    {% assign products_array = products | split: '||' %}

    {% if products_array.size == 0 %}
      <p>Vælg mindst ét produkt i sektionens indstillinger.</p>
    {% else %}

      {%- comment -%} Sticky product selectors {%- endcomment -%}
      {% if section.settings.enable_selectors %}
        <div class="comparison-selectors">
          <div class="selectors-desktop">
            {% for slot in (1..4) %}
              <select class="product-selector" data-slot="{{ slot }}">
                <option value="">Vælg et produkt</option>
                {% for prod in products_array %}
                  {% assign parts = prod | split: ':' %}
                  <option value="{{ parts[0] }}">{{ parts[1] }}</option>
                {% endfor %}
              </select>
            {% endfor %}
          </div>
          <div class="selectors-mobile">
            {% for slot in (1..2) %}
              <select class="product-selector" data-slot="{{ slot }}">
                <option value="">Vælg et produkt</option>
                {% for prod in products_array %}
                  {% assign parts = prod | split: ':' %}
                  <option value="{{ parts[0] }}">{{ parts[1] }}</option>
                {% endfor %}
              </select>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {%- comment -%} Header cards {%- endcomment -%}
      <div class="comparison-table">
        <div class="row row--header">
          {% for i in (1..6) %}
            {% assign prod_key = 'product_' | append: i %}
            {% assign title_key = 'product_title_' | append: i %}
            {% assign p = section.settings[prod_key] %}
            {% assign override = section.settings[title_key] %}
            {% if p != blank %}
              <div class="cell cell--product product-col product-{{ i }}">
                {% if section.settings.show_images and p.featured_image %}
                  <div class="product-thumb">
                    <img
                      src="{{ p.featured_image | image_url: width: 360, height: 360, crop: 'center' }}"
                      alt="{{ override | default: p.title | escape }}"
                      width="360" height="360" loading="lazy">
                  </div>
                {% endif %}
                <h3 class="product-title">{{ override | default: p.title }}</h3>
                <div class="product-price">
                  <span class="current">{{ p.price | money_without_trailing_zeros }}</span>
                  {% if p.compare_at_price > p.price %}
                    <span class="compare">Vejl. udsalgspris {{ p.compare_at_price | money_without_trailing_zeros }}</span>
                  {% endif %}
                </div>
                <a href="{{ p.url }}" class="product-link">Læs mere</a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {%- comment -%} Quick overview bullets (single heading, show bullets only for visible products) {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'product_bullets' %}
          <div class="row row--bullets" {{ block.shopify_attributes }}>
         {% if block.settings.bullets_heading != blank %}
  <div class="bullets-heading">{{ block.settings.bullets_heading }}</div>
{% endif %}
            {% for i in (1..6) %}
              {% assign prod_key = 'product_' | append: i %}
              {% if section.settings[prod_key] != blank %}
                <div class="cell cell--product product-col product-{{ i }}">
                  <ul class="product-bullets">
                    {% for j in (1..3) %}
                      {% assign bullet_key = 'bullet_product_' | append: i | append: '_' | append: j %}
                      {% assign bullet = block.settings[bullet_key] %}
                      {% if bullet != blank %}
                        <li>{{ bullet | replace: 'xx', checkbox_icon }}</li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}

      {%- comment -%} Accordions (grouped rows) {%- endcomment -%}
      {% assign groups_str = "|" %}
      {% for block in section.blocks %}
        {% assign g = block.settings.group | strip %}
        {% assign needle = "|" | append: g | append: "|" %}
        {% unless groups_str contains needle %}
          {% assign groups_str = groups_str | append: g | append: "|" %}
        {% endunless %}
      {% endfor %}
      {% assign groups_array = groups_str | split: "|" %}

      {% for g in groups_array %}
        {% if g != blank %}
          <details class="group-accordion"
  {% if section.settings.expand_all %}
    open="open"
  {% elsif section.settings.expand_first and forloop.first %}
    open="open"
  {% endif %}>
            <summary class="group-summary">
              <span class="group-name">{{ g }}</span>
              <span class="group-toggle"></span>
            </summary>
            <div class="group-rows">
              {% for block in section.blocks %}
                {% assign bg = block.settings.group | strip | default: "Generelt" %}
                {% if bg == g %}
                  <div class="row" {{ block.shopify_attributes }}>
                    <div class="cell cell--label desktop-only">{{ block.settings.label }}</div>
                    {% for i in (1..6) %}
                      {% assign prod_key = 'product_' | append: i %}
                      {% if section.settings[prod_key] != blank %}
                        {% assign val_key = 'value_product_' | append: i %}
                        {% assign img_key = 'image_product_' | append: i %}
                        {% assign val = block.settings[val_key] %}
                        {% assign val_img = block.settings[img_key] %}
                        <div class="cell cell--product product-col product-{{ i }}" data-label="{{ block.settings.label }}">
                          <div class="value-wrapper">
                            {% if val_img != blank %}
                              <div class="value-image">
                                <img
                                  src="{{ val_img | image_url: width: 420, height: 320, crop: 'center' }}"
                                  alt="{{ block.settings.label | escape }}"
                                  width="420" height="320" loading="lazy">
                              </div>
                            {% endif %}
                            {% if val != blank %}
                              <span class="value">{{ val }}</span>
                            {% else %}
                              <span class="value value--empty">&mdash;</span>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    {% endif %}
    {%- comment -%} equal (grouped rows) {%- endcomment -%}
 {% for block in section.blocks %}
  {% if block.type == 'product_bullets_equal' %}
    <div class="row row--bullets-equal" {{ block.shopify_attributes }}>
      <div class="cell cell--label">
        {% if block.settings.equal_bullets_heading != blank %}
          {{ block.settings.equal_bullets_heading }}
        {% endif %}
      </div>

      <!-- use cell--equal (not cell--product) so we don't inherit centering -->
      <div class="cell cell--equal">
        <ul class="product-bullets-equal">
          {% for i in (1..8) %}
            {% assign bullet_key = 'equal_bullet_' | append: i %}
            {% assign bullet = block.settings[bullet_key] %}
            {% if bullet != blank %}
              <li>{{ bullet | replace: 'xx', checkbox_icon }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}
{% endfor %}


  </div>
  <style>
    /* ---------- Headline ---------- */
    #section-{{ section.id }} .comparison-heading{
      margin-bottom:24px;font-size:2rem;font-weight:700;text-align:center;
    }

    /* ---------- Sticky selectors ---------- */
    #section-{{ section.id }} .comparison-selectors{
      position:sticky; top:0px; z-index:50; background:#FEFDF9; padding:16px 0; margin-bottom:0;
    }
    #section-{{ section.id }} .selectors-desktop{display:none;gap:10px;justify-content:center}
    #section-{{ section.id }} .selectors-mobile{display:flex;gap:10px}
    @media (min-width:1024px){
      #section-{{ section.id }} .selectors-desktop{display:flex}
      #section-{{ section.id }} .selectors-mobile{display:none}
    }
    #section-{{ section.id }} select{
      padding:6px 10px;border:1px solid #ccc;border-radius:8px;width:50%;min-width:unset;box-sizing:border-box;
    }
    @media (min-width:1024px){
      #section-{{ section.id }} select{width:25%;}
    }

    /* ---------- Header cards table ---------- */
    #section-{{ section.id }} .comparison-table{overflow:hidden;background:#FFF4E2;border-radius:0 0 25px 25px}
    #section-{{ section.id }} .row{display:flex;border-bottom:1px solid #e5e7eb}
    #section-{{ section.id }} .row:last-child{border-bottom:0}
    #section-{{ section.id }} .cell{padding:16px;display:flex;align-items:center;justify-content:center;text-align:center}
    #section-{{ section.id }} .cell--label{flex:0 0 200px;justify-content:flex-start;text-align:left;font-weight:400}
    #section-{{ section.id }} .cell--product{flex:1;display:none;flex-direction:column;background:transparent}
    #section-{{ section.id }} .cell--product.is-visible{display:flex}

    #section-{{ section.id }} .row--header{background:#FFF4E2;padding:30px 20px;border-radius:25px}
    #section-{{ section.id }} .product-thumb{width:210px;height:160px;margin:0 auto 10px;border-radius:8px;overflow:hidden}
    #section-{{ section.id }} .product-thumb img{width:100%;height:100%;object-fit:cover}
    #section-{{ section.id }} .product-title{font-weight:700;font-size:1.1rem;margin-bottom:6px}
    #section-{{ section.id }} .product-price{display:flex;flex-direction:column;align-items:center;font-weight:700;color:#C87D0A;font-size:1.2rem;line-height:1.3}
    #section-{{ section.id }} .product-price .compare{margin:4px 0 20px 0;font-size:.9rem;font-weight:400;color:#999;text-decoration:line-through}
    #section-{{ section.id }} .product-link{margin-top:4px;font-size:.9rem;text-decoration:underline}

    @media (max-width:1023px){
      #section-{{ section.id }} .row--header{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px;padding:2px}
      #section-{{ section.id }} .row--header .cell--product{border-right:0;align-items:center}
      #section-{{ section.id }} .product-thumb{width:140px;height:140px}
      #section-{{ section.id }} .comparison-table{padding:2px}
      #section-{{ section.id }} .row, #section-{{ section.id }} .cell{padding:8px 4px}
    }

    /* ---------- Bullets row ---------- */
    #section-{{ section.id }} .row--bullets{
      display:flex; align-items:flex-start; border-bottom:1px solid #e5e7eb; padding:22px 0;
    }
    #section-{{ section.id }} .row--bullets .bullets-heading{
      flex:0 0 200px; font-weight:700; font-size:1.1rem; text-align:left;
    }
    #section-{{ section.id }} .row--bullets .cell--product{
      flex:1; display:none; flex-direction:column; align-items:flex-start; text-align:left;
    }
  #section-{{ section.id }} .row--bullets .cell--product.is-visible {
  display: flex;
}

#section-{{ section.id }} .product-bullets {
  list-style: none;   /* fjern standard bullets */
  padding-left: 0;
  margin: 0;
}

#section-{{ section.id }} .product-bullets li {
  display: flex;
  align-items: center;
  gap: 6px;           /* afstand mellem ikon og tekst */
  margin-bottom: 6px;
  font-size: .95rem;
  line-height: 1.45;
}

#section-{{ section.id }} .product-bullets li svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: #C87D0A;     /* samme farve som øvrig tekst/brand */
}


    @media (max-width:1023px){
      #section-{{ section.id }} .row--bullets{display:grid; grid-template-columns:repeat(2,1fr); gap:10px}
      #section-{{ section.id }} .row--bullets .bullets-heading{grid-column:1/-1; margin-bottom:6px}
    }

    /* ---------- Accordions ---------- */
    #section-{{ section.id }} .group-accordion{border-top:1px solid #e5e7eb}
    #section-{{ section.id }} .group-summary{display:flex;justify-content:space-between;align-items:center;cursor:pointer;padding:14px 0;font-weight:700}
    #section-{{ section.id }} .group-toggle{width:16px;height:16px;position:relative}
    #section-{{ section.id }} .group-toggle::before,#section-{{ section.id }} .group-toggle::after{content:"";position:absolute;background:#111;transition:.2s}
    #section-{{ section.id }} .group-toggle::before{top:7px;left:0;right:0;height:2px}
    #section-{{ section.id }} .group-toggle::after{left:7px;top:0;bottom:0;width:2px}
    #section-{{ section.id }} .group-accordion[open] .group-toggle::after{transform:scaleY(0)}

    #section-{{ section.id }} .value-wrapper{display:flex;flex-direction:column;align-items:center;gap:6px}
    #section-{{ section.id }} .value-image img{
  max-width: 180px;       /* scale down if too big */
  height: auto;           /* keep aspect ratio */
  border-radius: 10px;       /* remove forced rounding */
  object-fit: contain;    /* fit fully inside box */
  display: block;
  margin: 0 auto;         /* center horizontally */
}


    /* Section spacing */
    #section-{{ section.id }}{margin-bottom:30px}

    @media (max-width: 1023px) {
  #section-{{ section.id }} .cell--label {
    display: none !important;
  }
}

/* Equal bullets row (aligned with accordions) */
#section-{{ section.id }} .row--bullets-equal{
  display:flex;
  align-items:flex-start;
  border-top:1px solid #e5e7eb;
  padding:22px 0;
  gap:30px; /* spacing between heading and list */
}

/* Heading – keep on one line */
#section-{{ section.id }} .row--bullets-equal .cell--label{
  flex:0 0 250px;         /* same width as your label column */
  font-weight:700;
  font-size:1rem;
  color:#2a1a0d;
  text-align:left;
  white-space:nowrap;     /* single line */
}

/* Bullet container – force left alignment (do not center) */
#section-{{ section.id }} .row--bullets-equal .cell--equal{
  flex:1;
  display:flex;
  justify-content:flex-start;
  align-items:flex-start;
  text-align:left;
}

/* The list */
#section-{{ section.id }} .product-bullets-equal{
  list-style:none;
  margin:0;
  padding:0;
}
#section-{{ section.id }} .product-bullets-equal li{
  display:flex;
  align-items:center;
  margin-bottom:8px;
  font-size:.95rem;
  line-height:1.45;
  color:#000;
}
#section-{{ section.id }} .product-bullets-equal li svg{
  width:16px;height:16px;margin-right:8px;
  color:#C87D0A; fill:#C87D0A; /* checkmark colour */
}

/* Mobile: stack heading over bullets */
@media (max-width:1023px){
  #section-{{ section.id }} .row--bullets-equal{
    flex-direction:column;
    gap:8px;
  }
  #section-{{ section.id }} .row--bullets-equal .cell--label{
    flex:0 0 auto;
  }
}

  </style>

  <script>
    (function(){
      var root = document.getElementById("section-{{ section.id }}");
      if(!root) return;

      var selectors = root.querySelectorAll(".product-selector");

      function updateVisibility(){
        var selected = Array.from(selectors).map(function(s){ return s.value; }).filter(Boolean);

        // Toggle for all product cells (header + bullets + accordion rows)
        root.querySelectorAll(".cell--product").forEach(function(c){
          c.classList.remove("is-visible");
        });
        selected.forEach(function(idx){
          root.querySelectorAll(".product-" + idx).forEach(function(c){
            c.classList.add("is-visible");
          });
        });

        // Disable already chosen products in other dropdowns
        selectors.forEach(function(sel){
          Array.from(sel.options).forEach(function(opt){
            if(opt.value && selected.includes(opt.value) && sel.value !== opt.value){
              opt.disabled = true;
            } else {
              opt.disabled = false;
            }
          });
        });
      }

      function preselect(){
        var isMobile = window.matchMedia("(max-width: 1023px)").matches;
        selectors.forEach(function(s){ s.value = ""; });
        if(isMobile){
          if(selectors[0]) selectors[0].value = "1";
        }else{
          if(selectors[0]) selectors[0].value = "1";
          if(selectors[1]) selectors[1].value = "2";
        }
        updateVisibility();
      }

      selectors.forEach(function(sel){ sel.addEventListener("change", updateVisibility); });
      preselect();

      var t;
      window.addEventListener("resize", function(){
        clearTimeout(t);
        t = setTimeout(function(){
          var anyChosen = Array.from(selectors).some(function(s){return s.value;});
          if(!anyChosen) preselect(); else updateVisibility();
        }, 150);
      });

      // Safety: ensure first accordion open if enabled (server already sets it)
     {% if section.settings.expand_all %}
  root.querySelectorAll(".group-accordion").forEach(function(acc){
    if(!acc.hasAttribute("open")) acc.setAttribute("open","open");
  });
{% elsif section.settings.expand_first %}
  var firstAcc = root.querySelector(".group-accordion");
  if(firstAcc && !firstAcc.hasAttribute("open")) firstAcc.setAttribute("open","open");
{% endif %}
    })();
  </script>
</section>

{% schema %}
