},
{
  "type": "product_bullets_equal",
  "name": "Fælles bullets",
  "settings": [
    {
      "type": "text",
      "id": "equal_bullets_heading",
      "label": "Overskrift til fælles bullets",
      "default": "Det har alle produkterne til fælles"
    },
    { "type": "text", "id": "equal_bullet_1", "label": "Bullet 1" },
    { "type": "text", "id": "equal_bullet_2", "label": "Bullet 2" },
    { "type": "text", "id": "equal_bullet_3", "label": "Bullet 3" },
    { "type": "text", "id": "equal_bullet_4", "label": "Bullet 4" },
