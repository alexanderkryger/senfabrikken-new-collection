    { "type": "text", "id": "bullet_product_3_2", "label": "Bullet 2 til Produkt 3" },
    { "type": "text", "id": "bullet_product_3_3", "label": "Bullet 3 til Produkt 3" },

    { "type": "text", "id": "bullet_product_4_1", "label": "Bullet 1 til Produkt 4" },
