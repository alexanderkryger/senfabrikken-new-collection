
  <!-- Start of the custom size filter accordion -->
  <!-- Start of the custom size filter accordion -->
  <details class="accordion group" is="accordion-disclosure" open="" aria-expanded="true">
    <summary style="pointer-events: none;">
      <span class="accordion__toggle text-font text-font-medium h6">
        <span class="text-with-icon gap-4">Størrelse</span> <!-- Replace 'Størrelse' with your size filter title -->
      </span>
    </summary>
    {%- assign filter_tags = section.settings.filter_tags | split: ', ' -%}
    <style>

  /* Styles for non-active labels */
.color-swatch-block .size-filter-label {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

/* Styles for links inside non-active labels */
.color-swatch-block .size-filter-label .size-filter-link {
    display: block;
    width: 100%;
    padding: 12px 14px;
    background: #FAF7F4;
    border: 1px solid #E0DCD9;
    color: var(--text-color); 
    font-size: 12px;
    border-radius: 4px;
    opacity: 1;
    text-align: center;
    cursor: pointer;
}

@media screen and (min-width: 1000px) {
    .color-swatch-block .size-filter-label:hover {
        background: rgb(var(--theme-color));
        border: none;
        color: #fff;
    }

    .color-swatch-block .size-filter-label:hover .size-filter-link {
        background: transparent; /* Makes sure the <a> tag doesn't override the label's hover effect */
        color: inherit; /* Ensures the link color matches the label */
    }
}

.color-swatch-block .size-filter-label.active .size-filter-link {
    background: rgb(var(--theme-color)); 
    color: #FFF;
    border: 0px solid #E0DCD9; 
}


</style>

    <div class="accordion__content" style="opacity: 1; transform: translateY(0px);">
      <div class="v-stack gap-2.5 filter-wrapper">
        <!-- Insert the new size filter logic here -->
        {%- for tag in collection.all_tags -%}
          {%- if filter_tags contains tag -%}
            <div class="checkbox-control color-swatch-block">
              <label for="size-{{ tag | handle }}" class="size-filter-label {% if current_tags contains tag %}active{% endif %}">
                <a href="javascript:void(0);" class="size-filter-link button-style" data-size="{{ tag | handle }}">{{ tag }}</a>
              </label>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </details>
  <!-- End of the custom size filter accordion -->
