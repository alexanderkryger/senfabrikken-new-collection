<div class="media-in-drawer-wrapper">
    <div class="media-in-drawer-video-container">
        {% if product.metafields.custom.video_info != blank %}
            {% assign video_info = product.metafields.custom.video_info.value %}
            {% if video_info != blank %}
                <video controls width="100%" style="border-radius: 4px;" poster="https://cdn.shopify.com/s/files/1/0710/4563/files/topmadras_thumbnail.jpg?v=1715762519">
                    <source src="{{ video_info.video_url }}" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            {% endif %}
        {% endif %}
    </div>
    <div class="media-in-drawer-text-container">
        {% if video_info != blank %}
            <h2 style="font-size: 16px; color: #2F1300; font-weight: 500;">{{ video_info.title }}</h2>
            <p style="font-size: 14px; color: #806F63;">{{ video_info.description }}</p>
        {% endif %}
    </div>
</div>
<style>
.media-in-drawer-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 25px;
}

.media-in-drawer-video-container, .media-in-drawer-text-container {
    flex: 1;
    min-width: 0; /* Adds flex-shrink to allow both columns to fit on mobile screens */
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .media-in-drawer-wrapper {
        flex-direction: row; /* Maintains the row layout on mobile */
    }

    .media-in-drawer-video-container video {
        width: 100%;  /* Ensure video scales correctly on smaller screens */
    }
}
</style>
