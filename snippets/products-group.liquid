<script type="application/json" data-current-variant>
  {
    "currentVariant": {{ product.selected_or_first_available_variant | json }}
  }
</script>

<form action="/cart" method="post" class="group_table grProdducts grprForm" id="cart-form" data-id="{{ product.selected_or_first_available_variant.id }}">


  {% assign option_count = 0 %}
  {%- for option in product.options_with_values -%}
  {% assign option_count = option_count |  plus: 1 %}
  {%- endfor -%}
  <ul class="group-prod product-info-ul" style="display:flex; flex-direction:column;">
    {% for gppr in product.metafields.custom.group.value %}
        {%- assign sold_out = true -%}
        {%- if gppr.available  -%}{%- assign sold_out = false -%}{%- endif -%}

        {%- unless sold_out -%}
          {%- assign current_variant = gppr.selected_or_first_available_variant -%}
          {%- assign image = current_variant.featured_image | default: gppr.featured_image -%}
          {%- assign on_sale = false -%}

          {%- if current_variant.compare_at_price > current_variant.price -%}
              {%- assign on_sale = true -%}
          {%- endif -%}

          {%- assign index = forloop.index -%}
          {%- assign cu_pr = current_variant.price -%}
          {%- assign price = price | plus:cu_pr -%}
          {% if gppr == product %}
            <li class="group-prod-item main clearfix text-left" style="margin-bottom: 15px; order: 999;">
              <input type="hidden" value="{{ current_variant.price }}" class="vrPrice">

              <div class="qtyField hidden" title="{{ 'products.product.quantity' | t }}">
                <a class="minus gprQty" href="javascript:void(0);"><i class="at at-minus-r" aria-hidden="true"></i></a>
                <input type="text" id="qty{{ gppr.id }}" name="quantity" value="1" class="product-form__input qty mainprqty" />
                <a class="plus gprQty" href="javascript:void(0);">
                <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 12 }}" class="{{ class | strip }}" viewBox="0 0 12 12">
                  <path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="{{ stroke_width | default: settings.icon_stroke_width }}"/>
                </svg>
                </a>
              </div>
            </li>

            {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}

              {%- liquid
                assign current_variant = product.selected_or_first_available_variant
                assign currentValue = false

                for value in option.values
                  assign optionkey = 'option' | append: option.position
                  assign relatedVariant = product.variants | where: optionkey, value | first

                  if relatedVariant
                    assign image = relatedVariant.image | default: current_variant.featured_image

                    if option.selected_value == value
                      assign currentValue = relatedVariant[optionkey]
                    endif
                  endif
                endfor
              -%}
              <li class="group-prod-item clearfix text-left mfp-link" data-options {% if option_count < 0 %}data-extra{% endif %} data-current-product-variants>

                <div  class="details">
                  <div class="product-name">

                       <div class="drawer-btn" data-drawer-btn="{{ option.name }}">
                        <div class="drawer-btn__title">{{ option.name }}</div>
                       </div>
                  </div>

                  <div class="gpprVariants mfp-link">
                    <input type="hidden" value="0" class="vrPrice">
                    <span class="gprvrAct optPopup variant-value"><span class="variant-example"></span>
                    <span class="variant-active__icon">{%- render 'icon' with 'checkmark'-%}</span>
                    </span>
                    <div class="sidebar-drawer" data-drawer="{{ option.name }}">
                      <div class="Drawer__Header">
                        <div class="sidebar-drawer__close Drawer__Close Icon-Wrapper--clickable">
                          {%- render 'icon' with 'custom-arrow-left' -%}
                          <span>Tilbage</span>
                        </div>
                      </div>
                  
                    
                        <div class="sidebar-drawer__content">
                          <div class="sidebar-drawer__content__scroll">
                            <div class="">
                              <h3 class="heading h3">{{ option.name }}</h3>
                              <div class="">{{ current_variant.metafields.custom.fasthed_tekst | metafield_tag }}</div>
                            </div>
                            <br>

                            <ul class="gprvrList" data-prod-title="{{ product.title }}">
                            {%- for value in option.values -%}
                              {%- liquid
                                assign optionkey = 'option' | append: option.position
                                assign relatedVariant = product.variants | where: optionkey, value | first
                              -%}

                              {%- if relatedVariant.available -%}
                                {%- liquid
                                  assign priceDifference = relatedVariant.price | minus: current_variant.price
                                  assign relatedPrice = priceDifference
                                -%}

                                {%- liquid
                                  assign colors = 'color,farve,vaelg-farve,select-color,vaelg-fasthed,vaelg-fasthed-2,vaelg-fasthed-1' | split: ','
                                  assign optionName = option.name | handleize
                                  assign colorConfig = settings.color_config | newline_to_br | split: '<br />'

                                  assign relImage = relatedVariant.image | img_url: '400x'

                                  if colors contains optionName
                                    for color in colorConfig
                                      assign colorParts = color | split: ':'
                                      assign colorLabel = colorParts | first | strip

                                      if colorLabel == relatedVariant[optionkey]
                                        assign relImage = colorParts | last | strip | file_img_url: '400x300'
                                      endif
                                    endfor
                                  endif
                                -%}
                                <li class="gprvr sidebar-drawer__option{% comment %} {% if relatedVariant == current_variant %} active{% endif %} {% endcomment %}" data-main-variant="true" data-prod="{{ product.id }}{{ option.position }}" data-id="{{ relatedVariant.id }}" data-price="{{ relatedPrice }}" data-quantity="{%- if relatedVariant.inventory_management == blank or relatedVariant.inventory_policy == 'continue' -%}999{%- else -%}{{ relatedVariant.inventory_quantity }}{%- endif -%}">
                                {% comment %}  <div>
                                  <p class="option-image"><img src="{{ relImage }}" alt="{{ relatedVariant.title }}"></p>
                                  <p class="name">{{ relatedVariant[optionkey] }}</p>
                                  <b class="price">{{ relatedPrice | money }}</b>
                                  </div>
                                  <p>test 5</p>
                                </li>
                                <li class="gprvr sidebar-drawer__option" data-prod="{{ gppr.id }}" data-id="{{ variant.id }}" data-price="{{ variant.price }}" data-quantity="{%- if variant.inventory_management == blank or variant.inventory_policy == 'continue' -%}999{%- else -%}{{ variant.inventory_quantity }}{%- endif -%}">
                                    {% endcomment %}<p class="option-image"><img src="{{ relImage }}" alt="{{ relatedVariant.title }}" /></p>
                                    <div>
                                      {% if relatedVariant[optionkey] contains " - " %}
                                        {% assign titleSplit = relatedVariant[optionkey] | split: " - " %}
                                        <p class="name hidden">{{ relatedVariant[optionkey] }}</p>
                                        <p class="visually-name">{{ titleSplit[0] }}</p>
                                        <p class="text">{{ titleSplit[1] }}</p>
                                      {% else %}
                                        <p class="name">{{ relatedVariant[optionkey] }}</p>
                                      {% endif %}
                                      <b class="price">{{ relatedPrice | money }}</b>
                                  </div>
                                  <span class="variant-active__icon">{%- render 'icon' with 'checkmark'-%}</span>
                                  </li>
                              {%- endif -%}
                            {%- endfor -%}

                          </ul>
                        <div class="fake-confirm-btn__wrapper">
                      <div class="fake-confirm-btn btn btn--large gpr-form-cart button w-full">Bekræft</div>
                      </div>
                    </div>

                    </div>
                    </div>

                    <input class="hidden_txt v_hidden hidden" type="text" name="properties[main]" value="{{ product.title }}" >
                    <input class="hidden_txt v_hidden hidden" type="hidden" name="main" value="true">
                    <input type="text" value="" class="product-form__input qty" name="updates[{{ relatedVariant.id }}]" id="qty{{ product.id }}{{ option.position }}" min="0" max="{%- if current_variant.inventory_quantity <= 0 and current_variant.available and current_variant.inventory_management != null -%}999{%- elsif current_variant.inventory_management != null -%}{{current_variant.inventory_quantity}}{%- else -%}999{%- endif -%}" required/>
                  </div>

                  {%- render 'icon' with 'chevron-right' -%}
