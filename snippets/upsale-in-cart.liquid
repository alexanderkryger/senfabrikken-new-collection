{% if upsalePr.product.metafields.custom.product_upsale.value != blank %}
    <div class="cartUpsale__wrapper">
        <p class="ttl">Spar op til 40% på tilbehør</p>
        <div class="upsaleList">
            {% assign currentVariant = product.selected_or_first_available_variant.id %}
              {%- for product in upsalePr.product.metafields.custom.product_upsale.value -%}
                {%- if product.available -%}
                  <div class="upsaleItem">
                    <p class="img"><a href="{{ product.url }}"><img src="{{ product.media | first | img_url: '200x200', crop: 'center' }}" alt="{{ product.title }}" /></a></p>
                    <div class="details">
                        <p class="name">{{ product.title }}</p>
                        <b class="vprice" style="color: #c87d0a;">{{ product.price | money }}</b>
                        <b class="cprice text-subdued line-through">{{ product.compare_at_price| money }}</b>

                        {%- if product.available -%}
                          {%- form 'product', product, is: 'product-form', class:'upsaleFrom' -%}
                            <button type="button" class="quick-add-button upsaleadd" data-id="{{ product.selected_or_first_available_variant.id }}">{{ 'product.general.add_to_cart_button' | t }}</button>
                            <input type="hidden" name="id" class="cartUpdsaleId" value="">
                            <button type="submit" class="upsalesubmit hide" style="display:none;">{{ 'product.general.add_to_cart_button' | t }}</button>
                          {%- endform -%}
                        {%- endif -%}

                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          
            <div class="fPoints">
                <p>
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none" class="icon icon-picto-dansk-flag"><path d="M19.0005 11.0005H6.00055V22.0005M19.0005 11.0005V22.0005H6.00055M19.0005 11.0005H23.0005M6.00055 22.0005L6.0025 26.0005M19.0005 37.0005H6.00055V26.0005H6.0025M19.0005 37.0005V26.0005H6.0025M19.0005 37.0005H23.0005M23.0005 11.0005H42.0005V22.0005M23.0005 11.0005V22.0005H42.0005M42.0005 22.0005V26.0005M42.0005 26.0005H23.0005V37.0005M42.0005 26.0005V37.0005H23.0005" stroke="#2F1300" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  Danskproducerede senge
                </p>
                <p>
                  <svg xmlns="http://www.w3.org/2000/svg" width="49" height="48" viewBox="0 0 49 48" fill="none" class="icon icon-picto-garanti"><path d="M22.1687 4.38121C23.6865 3.025 25.9807 3.02501 27.4985 4.38122L30.4406 7.01005C31.1161 7.61365 31.9765 7.97005 32.881 8.0209L36.8202 8.24237C38.8524 8.35663 40.4747 9.97891 40.5889 12.0111L40.8104 15.9503C40.8613 16.8548 41.2177 17.7152 41.8213 18.3908L44.4501 21.3328C45.8063 22.8506 45.8063 25.1448 44.4501 26.6626L41.8213 29.6047C41.2177 30.2802 40.8613 31.1406 40.8104 32.0451L40.5889 35.9843C40.4747 38.0165 38.8524 39.6388 36.8202 39.7531L32.881 39.9745C31.9765 40.0254 31.1161 40.3818 30.4406 40.9854L27.4985 43.6142C25.9807 44.9704 23.6865 44.9704 22.1687 43.6142L19.2266 40.9854C18.5511 40.3818 17.6907 40.0254 16.7862 39.9745L12.847 39.7531C10.8148 39.6388 9.19251 38.0165 9.07825 35.9843L8.85678 32.0451C8.80593 31.1406 8.44953 30.2802 7.84593 29.6047L5.21709 26.6626C3.86088 25.1448 3.86088 22.8506 5.21709 21.3328L7.84593 18.3908C8.44953 17.7152 8.80593 16.8548 8.85678 15.9503L9.07825 12.0111C9.19251 9.97891 10.8148 8.35663 12.847 8.24237L16.7862 8.0209C17.6907 7.97005 18.5511 7.61365 19.2266 7.01005L22.1687 4.38121Z" stroke="#2F1300" stroke-width="2" stroke-linejoin="round"></path><path d="M15.8347 23.1429L22.0979 30L32.8347 18" stroke="#2F1300" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  25 års garanti
                </p>
                <p>
                  <svg xmlns="http://www.w3.org/2000/svg" width="49" height="48" viewBox="0 0 49 48" fill="none" class="icon icon-picto-trustpilot"><path d="M24.668 5.99902L30.5452 17.9076L43.6871 19.8172L34.1775 29.0868L36.4225 42.1756L24.668 35.9959L12.9135 42.1756L15.1584 29.0868L5.64878 19.8172L18.7907 17.9076L24.668 5.99902Z" stroke="#2F1300" stroke-width="2" stroke-linejoin="round"></path></svg>
                  4,4 på Trustpilot
                </p>
            </div>
      </div>
    {%- endif -%}