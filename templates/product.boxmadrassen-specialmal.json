          "settings": {
            "title": "Topmadras",
            "content": "<p><strong>Valgfri (Latex el. Celcius)</strong></p><ul><li>Totalhøjde: ca. 70 mm.</li><li>Kernehøjde: 40 mm.</li><li>Aftageligt og vaskbart betræk.</li></ul>"
          }
        }
      },
      "block_order": [
        "59ee6765-203f-4f1a-8e4d-4df17cbd6d55",
