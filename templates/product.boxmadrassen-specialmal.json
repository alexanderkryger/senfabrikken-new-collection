      "settings": {
        "title": "Boxmadrassens specifikationer",
        "content": "<p>Tag et deep-dive ned i Boxmadrassen. Vi står inde for kvaliteten og spiller med helt åbne kort, så du ved, hvad du får. </p>",
        "background": "#fff8f2",
